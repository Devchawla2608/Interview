  view_file {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    end_line: 99
    content: "import React, { useState, useEffect } from \'react\';\nimport { User, NotificationItem } from \'../types\';\nimport { api, setCurrentUser } from \'../services/api\';\nimport { useTheme } from \'../context/ThemeContext\';\nimport {\n  ShieldAlert,\n  Users,\n  Compass,\n  Briefcase,\n  Layers,\n  Bell,\n  CheckCircle2,\n  Clock,\n  Sparkles,\n  ChevronDown,\n  LogOut,\n  HelpCircle,\n  FileText,\n  Sun,\n  Moon,\n} from \'lucide-react\';\n\ninterface NavbarProps {\n  currentUser: User | null;\n  onUserChange: (user: User) => void;\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  activeQueueCount: number;\n  onOpenPolicies: (policy: \'terms\' | \'refund\' | \'privacy\' | \'faq\') => void;\n  onOpenQueueTracker: () => void;\n  hasActiveQueue: boolean;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  currentUser,\n  onUserChange,\n  activeTab,\n  setActiveTab,\n  activeQueueCount,\n  onOpenPolicies,\n  onOpenQueueTracker,\n  hasActiveQueue,\n}) => {\n  const [showUserMenu, setShowUserMenu] = useState(false);\n  const [showNotifMenu, setShowNotifMenu] = useState(false);\n  const [notifications, setNotifications] = useState<NotificationItem[]>([]);\n  const { theme, toggleTheme } = useTheme();\n\n  useEffect(() => {\n    fetchNotifications();\n    const interval = setInterval(fetchNotifications, 10000);\n    return () => clearInterval(interval);\n  }, [currentUser?.id]);\n\n  const fetchNotifications = async () => {\n    try {\n      const res = await api.getNotifications();\n      setNotifications(res.notifications || []);\n    } catch {\n      // ignore\n    }\n  };\n\n  const handleRoleSwitch = async (role: \'CANDIDATE\' | \'INTERVIEWER\' | \'ADMIN\') => {\n    try {\n      const res = await api.switchRole(role);\n      setCurrentUser(res.user.id, role);\n      onUserChange(res.user);\n      if (role === \'CANDIDATE\') setActiveTab(\'candidate-dashboard\');\n      else if (role === \'INTERVIEWER\') setActiveTab(\'interviewer-dashboard\');\n      else if (role === \'ADMIN\') setActiveTab(\'admin-dashboard\');\n      setShowUserMenu(false);\n    } catch (err: any) {\n      console.error(\'Role switch failed:\', err.message);\n    }\n  };\n\n  const handleQuickUserSwitch = async (userId: string, role: string) => {\n    try {\n      setCurrentUser(userId, role);\n      const res = await api.getMe();\n      onUserChange(res.user);\n      if (role === \'CANDIDATE\') setActiveTab(\'candidate-dashboard\');\n      else if (role === \'INTERVIEWER\') setActiveTab(\'interviewer-dashboard\');\n      else if (role === \'ADMIN\') setActiveTab(\'admin-dashboard\');\n      setShowUserMenu(false);\n    } catch (err: any) {\n      console.error(\'User switch failed:\', err.message);\n    }\n  };\n\n  const unreadCount = notifications.filter((n) => !n.isRead).length;\n\n  const handleMarkAllRead = async () => {\n    await api.markAllNotificationsRead();\n    setNotifications((prev) => prev.map((n) => ({ ...n, isRead: true })));\n  };\n\n  return (\n    <header className=\"sticky top-0 z-50 bg-slate-900/95 backdrop-blur border-b border-slate-800 text-slate-100\">"
    num_lines: 429
