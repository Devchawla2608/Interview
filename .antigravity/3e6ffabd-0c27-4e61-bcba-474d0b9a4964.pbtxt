    content: "            <div className=\"p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-start space-x-3 text-xs text-emerald-300\">\n              <ShieldCheck className=\"w-5 h-5 shrink-0 text-emerald-400 mt-0.5\" />\n              <div>\n                <span className=\"font-bold text-white\">100% Refund Guarantee</span>\n                <p className=\"text-[11px] text-emerald-300/90 mt-0.5\">\n                  If you cancel before an interviewer is assigned, or if no interviewer claims your session before queue timeout, your payment is refunded automatically in full.\n                </p>\n              </div>\n            </div>\n\n            {/* Actions */}\n            <div className=\"flex items-center space-x-3\">\n              <button\n                type=\"button\"\n                onClick={onClose}\n                className=\"flex-1 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs transition\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"button\"\n                disabled={isProcessing}\n                onClick={handleInitiateCheckout}\n                className=\"flex-1 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white font-bold text-xs shadow-lg shadow-indigo-600/30 transition flex items-center justify-center space-x-2\"\n              >\n                {isProcessing ? (\n                  <span>Preparing order...</span>\n                ) : (\n                  <>\n                    <span>Pay \342\202\271{tier.price} & Proceed</span>\n                    <ArrowRight className=\"w-4 h-4\" />\n                  </>\n                )}\n              </button>\n            </div>\n          </div>\n        ) : (\n          /* Razorpay Test Gateway Simulation Modal */\n          <div className=\"p-6 space-y-6 bg-slate-900\">\n            <div className=\"text-center space-y-1\">\n              <div className=\"inline-flex items-center space-x-1.5 px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/30 text-[11px] font-bold\">\n                <Lock className=\"w-3 h-3\" />\n                <span>Razorpay Test Gateway Simulator</span>\n              </div>\n              <h4 className=\"text-xl font-extrabold text-white\">Pay \342\202\271{tier.price}.00</h4>\n              <p className=\"text-xs text-slate-400\">Order ID: {orderInfo?.orderId}</p>\n            </div>\n\n            {/* Payment Method Selector */}\n            <div className=\"grid grid-cols-2 gap-3\">\n              <button\n                onClick={() => setPaymentMethod(\'UPI\')}\n                className={`p-3 rounded-xl border text-center text-xs font-semibold transition ${\n                  paymentMethod === \'UPI\'\n                    ? \'bg-blue-600/20 border-blue-500 text-white\'\n                    : \'bg-slate-950 border-slate-800 text-slate-400\'\n                }`}\n              >\n                Instant UPI (GPay/PhonePe)\n              </button>\n              <button\n                onClick={() => setPaymentMethod(\'CARD\')}\n                className={`p-3 rounded-xl border text-center text-xs font-semibold transition ${\n                  paymentMethod === \'CARD\'\n                    ? \'bg-blue-600/20 border-blue-500 text-white\'\n                    : \'bg-slate-950 border-slate-800 text-slate-400\'\n                }`}\n              >\n                Debit / Credit Card\n              </button>\n            </div>\n\n            {/* Method Details */}\n            {paymentMethod === \'UPI\' ? (\n              <div className=\"p-4 rounded-xl bg-slate-950 border border-slate-800 text-xs space-y-2\">\n                <div className=\"text-slate-300 font-medium\">Virtual Payment Address (VPA):</div>\n                <div className=\"p-2 rounded bg-slate-900 border border-slate-800 font-mono text-indigo-300\">\n                  candidate@okhdfcbank\n                </div>\n                <p className=\"text-[11px] text-slate-400\">\n                  Ready to simulate instant OTP-less test capture.\n                </p>\n              </div>\n            ) : (\n              <div className=\"p-4 rounded-xl bg-slate-950 border border-slate-800 text-xs space-y-2\">\n                <div className=\"text-slate-300 font-medium\">Test Card Number:</div>\n                <div className=\"p-2 rounded bg-slate-900 border border-slate-800 font-mono text-indigo-300\">\n                  4111 \342\200\242\342\200\242\342\200\242\342\200\242 \342\200\242\342\200\242\342\200\242\342\200\242 1111 (Razorpay Test Card)\n                </div>\n                <div className=\"flex space-x-2 text-[11px] text-slate-400\">\n                  <span>Exp: 12/28</span>\n                  <span>\342\200\242</span>\n                  <span>CVV: 123</span>\n                </div>\n              </div>\n            )}\n\n            {/* Note on security */}\n            <div className=\"text-[11px] text-slate-500 text-center\">\n              Secured with 256-bit TLS encryption. Test mode enabled for development verification.\n            </div>\n\n            {/* Action */}\n            <button\n              onClick={handleSimulatePaymentSuccess}\n              disabled={isProcessing}\n              className=\"w-full py-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 disabled:opacity-50 text-white font-bold text-sm shadow-lg shadow-blue-600/30 transition flex items-center justify-center space-x-2\"\n            >\n              {isProcessing ? (\n                <span>Verifying signature & entering queue...</span>\n              ) : (\n                <span>Authorize & Complete Test Payment (\342\202\271{tier.price})</span>\n              )}\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
