  planner_response {
    thinking: "**Defining the Dashboard Structure**\n\nI\'m currently focused on structuring the `InterviewerDashboard` component. My primary concern is the inclusion of an availability toggle, ensuring only approved interviewers can switch between online and offline states. I\'m also planning to incorporate a status banner, prominently displaying the interviewer\'s approval status (e.g., \"Approved - Sarah Chen\").\n\n\n"
    tool_calls {
      id: "call_892224"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport { User, QueueEntry, Booking, InterviewerEarnings } from \'../types\';\\nimport { api } from \'../services/api\';\\nimport {\\n  Briefcase,\\n  Zap,\\n  Clock,\\n  CheckCircle2,\\n  AlertCircle,\\n  Video,\\n  DollarSign,\\n  TrendingUp,\\n  Calendar,\\n  Lock,\\n  ArrowRight,\\n  ShieldAlert,\\n  Wallet,\\n  Building,\\n} from \'lucide-react\';\\n\\ninterface InterviewerDashboardProps {\\n  currentUser: User | null;\\n  onOpenWorkspace: (bookingId: string) => void;\\n  onNavigateToApplication: () => void;\\n}\\n\\nexport const InterviewerDashboard: React.FC<InterviewerDashboardProps> = ({\\n  currentUser,\\n  onOpenWorkspace,\\n  onNavigateToApplication,\\n}) => {\\n  const [profile, setProfile] = useState<any>(null);\\n  const [queue, setQueue] = useState<QueueEntry[]>([]);\\n  const [earnings, setEarnings] = useState<InterviewerEarnings | null>(null);\\n  const [activeBookings, setActiveBookings] = useState<Booking[]>([]);\\n  const [isAvailable, setIsAvailable] = useState(false);\\n  const [claimingId, setClaimingId] = useState<string | null>(null);\\n  const [claimError, setClaimError] = useState<string | null>(null);\\n  const [showPayoutModal, setShowPayoutModal] = useState(false);\\n  const [payoutAmount, setPayoutAmount] = useState(\'\');\\n  const [payoutUpi, setPayoutUpi] = useState(\'\');\\n  const [isProcessingPayout, setIsProcessingPayout] = useState(false);\\n\\n  useEffect(() => {\\n    loadData();\\n    const interval = setInterval(loadData, 4000); // sync live queue\\n    return () => clearInterval(interval);\\n  }, [currentUser?.id]);\\n\\n  const loadData = async () => {\\n    try {\\n      const [profRes, queueRes, earnRes, bookingsRes] = await Promise.all([\\n        api.getInterviewerProfile(),\\n        api.getQueue(),\\n        api.getInterviewerEarnings(),\\n        api.getBookings(),\\n      ]);\\n\\n      setProfile(profRes.profile);\\n      setIsAvailable(profRes.profile?.isAvailable || false);\\n      setQueue(queueRes.queue || []);\\n      setEarnings(earnRes.earnings);\\n      setPayoutUpi(profRes.profile?.upiId || \'sarah.chen@okhdfcbank\');\\n\\n      const myActive = (bookingsRes.bookings || []).filter(\\n        (b) => b.interviewerId === currentUser?.id && [\'CLAIMED\', \'READY\', \'IN_PROGRESS\'].includes(b.status)\\n      );\\n      setActiveBookings(myActive);\\n    } catch (err) {\\n      console.error(\'Failed to load interviewer dashboard data:\', err);\\n    }\\n  };\\n\\n  const handleToggleAvailability = async () => {\\n    try {\\n      const res = await api.toggleAvailability();\\n      setIsAvailable(res.isAvailable);\\n    } catch (err: any) {\\n      alert(err.message || \'Failed to toggle availability\');\\n    }\\n  };\\n\\n  const handleClaimSession = async (bookingId: string) => {\\n    setClaimingId(bookingId);\\n    setClaimError(null);\\n    try {\\n      const res = await api.claimQueueEntry(bookingId);\\n      if (res.success) {\\n        onOpenWorkspace(res.booking.id);\\n      }\\n    } catch (err: any) {\\n      setClaimError(err.message || \'This session was already claimed by another interviewer.\');\\n      // refresh queue\\n      loadData();\\n    } finally {\\n      setClaimingId(null);\\n    }\\n  };\\n\\n  const handleRequestPayout = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const amt = Number(payoutAmount);\\n    if (!amt || amt <= 0) return;\\n\\n    setIsProcessingPayout(true);\\n    try {\\n      const res = await api.requestPayout(amt, payoutUpi);\\n      setEarnings(res.earnings);\\n      setShowPayoutModal(false);\\n      setPayoutAmount(\'\');\\n      alert(`Payout of \342\202\271${amt} processed successfully to ${payoutUpi}`);\\n    } catch (err: any) {\\n      alert(err.message || \'Payout request failed\');\\n    } finally {\\n      setIsProcessingPayout(false);\\n    }\\n  };\\n\\n  const isApproved = profile?.status === \'APPROVED\';\\n\\n  return (\\n    <div className=\\\"space-y-8 pb-16\\\">\\n      {/* Top Header & Availability Radar */}\\n      <div className=\\\"rounded-3xl bg-slate-900 border border-slate-800 p-6 sm:p-8 shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-6\\\">\\n        <div>\\n          <div className=\\\"flex items-center space-x-2\\\">\\n            <span\\n              className={`text-xs font-bold px-2.5 py-0.5 rounded-full border ${\\n                isApproved\\n                  ? \'bg-emerald-500/20 text-emerald-300 border-emerald-500/30\'\\n                  : \'bg-amber-500/20 text-amber-300 border-amber-500/30\'\\n              }`}\\n            >\\n              {isApproved ? \'APPROVED INTERVIEWER\' : `STATUS: ${profile?.status || \'SUBMITTED\'}`}\\n            </span>\\n            <span className=\\\"text-xs text-slate-400\\\">80% Revenue Share</span>\\n          </div>\\n\\n          <h1 className=\\\"text-2xl sm:text-3xl font-extrabold text-white mt-1\\\">\\n            {currentUser?.fullName} \342\200\224 Interviewer Portal\\n          </h1>\\n          <p className=\\\"text-xs sm:text-sm text-slate-300 mt-1 max-w-2xl\\\">\\n            {profile?.headline || \'Senior Software Engineer\'} \342\200\242 {profile?.experienceYears || 5} Years Experience\\n          </p>\\n        </div>\\n\\n        {/* Availability Toggle */}\\n        <div className=\\\"flex items-center space-x-4 bg-slate-950 p-4 rounded-2xl border border-slate-800 shrink-0\\\">\\n          <div>\\n            <div className=\\\"text-xs font-bold text-white flex items-center space-x-1.5\\\">\\n              <span\\n                className={`w-2.5 h-2.5 rounded-full ${\\n                  isAvailable ? \'bg-emerald-400 animate-pulse\' : \'bg-slate-500\'\\n                }`}\\n              />\\n              <span>{isAvailable ? \'Online & Available\' : \'Currently Offline\'}</span>\\n            </div>\\n            <div className=\\\"text-[11px] text-slate-400 mt-0.5\\\">\\n              {isAvailable ? \'Receiving real-time match requests\' : \'Toggle on to accept queue requests\'}\\n            </div>\\n          </div>\\n\\n          <button\\n            onClick={handleToggleAvailability}\\n            disabled={!isApproved}\\n            className={`px-4 py-2 rounded-xl text-xs font-bold transition shadow-md ${\\n              !isApproved\\n                ? \'opacity-40 cursor-not-allowed bg-slate-800 text-slate-400\'\\n                : isAvailable\\n                ? \'bg-rose-600 hover:bg-rose-500 text-white\'\\n                : \'bg-emerald-600 hover:bg-emerald-500 text-white\'\\n            }`}\\n          >\\n            {isAvailable ? \'Go Offline\' : \'Go Online\'}\\n          </button>\\n        </div>\\n      </div>\\n\\n      {!isApproved && (\\n        <div className=\\\"rounded-2xl bg-amber-500/10 border border-amber-500/20 p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n          <div className=\\\"flex items-start space-x-3 text-amber-300\\\">\\n            <ShieldAlert className=\\\"w-5 h-5 shrink-0 mt-0.5\\\" />\\n            <div>\\n              <h4 className=\\\"font-bold text-white text-sm\\\">Screening In Progress</h4>\\n              <p className=\\\"text-xs text-amber-200/90 mt-0.5\\\">\\n                To guarantee high mock interview quality, each applicant must complete 2 screening sessions evaluated against structured rubrics before accepting paid sessions.\\n              </p>\\n            </div>\\n          </div>\\n          <button\\n            onClick={onNavigateToApplication}\\n            className=\\\"px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shrink-0 transition\\\"\\n          >\\n            Track Screening Status\\n          </button>\\n        </div>\\n      )}\\n\\n      {/* Claim Error Alert */}\\n      {claimError && (\\n        <div className=\\\"p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs flex items-center justify-between\\\">\\n          <div className=\\\"flex items-center space-x-2\\\">\\n            <AlertCircle className=\\\"w-4 h-4 shrink-0\\\" />\\n            <span>{claimError}</span>\\n          </div>\\n          <button\\n            onClick={() => setClaimError(null)}\\n            className=\\\"text-xs text-rose-400 underline font-semibold ml-4\\\"\\n          >\\n            Dismiss\\n          </button>\\n        </div>\\n      )}\\n\\n      {/* Active Claimed Sessions */}\\n      {activeBookings.length > 0 && (\\n        <div className=\\\"space-y-4\\\">\\n          <h2 className=\\\"text-lg font-bold text-white flex items-center space-x-2\\\">\\n            <Video className=\\\"w-5 h-5 text-emerald-400\\\" />\\n            <span>Your Claimed Active Sessions ({activeBookings.length})</span>\\n          </h2>\\n\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n            {activeBookings.map((b) => (\\n              <div\\n                key={b.id}\\n                className=\\\"rounded-2xl bg-slate-900 border-2 border-emerald-500/30 p-5 space-y-4 shadow-xl\\\"\\n              >\\n                <div className=\\\"flex justify-between items-start\\\">\\n                  <div>\\n                    <span className=\\\"text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300\\\">\\n                      SESSION IN PROGRESS\\n                    </span>\\n                    <h3 className=\\\"text-base font-bold text-white mt-1\\\">{b.trackName}</h3>\\n                    <p className=\\\"text-xs text-slate-400\\\">{b.roundName}</p>\\n                  </div>\\n                  <span className=\\\"text-base font-extrabold text-emerald-400\\\">\\n                    +\342\202\271{b.interviewerEarnings}\\n                  </span>\\n                </div>\\n\\n                <div className=\\\"p-3 rounded-xl bg-slate-950 text-xs space-y-1 border border-slate-800\\\">\\n                  <div className=\\\"flex justify-between text-slate-300\\\">\\n                    <span>Candidate:</span>\\n                    <span className=\\\"font-semibold text-white\\\">{b.candidateName}</span>\\n                  </div>\\n                  <div className=\\\"flex justify-between text-slate-300\\\">\\n                    <span>Role & Language:</span>\\n                    <span className=\\\"text-slate-300\\\">{b.jobRole} \342\200\242 {b.preferredLanguage}</span>\\n                  </div>\\n                </div>\\n\\n                <button\\n                  onClick={() => onOpenWorkspace(b.id)}\\n                  className=\\\"w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-md transition flex items-center justify-center space-x-2\\\"\\n                >\\n                  <Video className=\\\"w-4 h-4\\\" />\\n                  <span>Enter Live Workspace & Conduct Mock</span>\\n                </button>\\n              </div>\\n            ))}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Live Incoming Queue Radar */}\\n      <div className=\\\"space-y-4\\\">\\n        <div className=\\\"flex items-center justify-between\\\">\\n          <div>\\n            <h2 className=\\\"text-lg font-bold text-white flex items-center space-x-2\\\">\\n              <Zap className=\\\"w-5 h-5 text-amber-400\\\" />\\n              <span>Incoming Queue Requests ({queue.length})</span>\\n            </h2>\\n            <p className=\\\"text-xs text-slate-400\\\">\\n              Real-time waiting candidates. 1-click atomic acceptance locks the session exclusively for you.\\n            </p>\\n          </div>\\n          <span className=\\\"text-xs text-slate-400\\\">FIFO Ordering</span>\\n        </div>\\n\\n        {queue.length === 0 ? (\\n          <div className=\\\"rounded-2xl bg-slate-900 border border-slate-800 p-8 text-center space-y-2\\\">\\n            <Clock className=\\\"w-8 h-8 text-slate-600 mx-auto\\\" />\\n            <h3 className=\\\"text-sm font-semibold text-slate-300\\\">No candidates in queue right now</h3>\\n            <p className=\\\"text-xs text-slate-500 max-w-sm mx-auto\\\">\\n              New requests will automatically pop up here as candidates complete checkout. Keep your availability online.\\n            </p>\\n          </div>\\n        ) : (\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\\\">\\n            {queue.map((item) => (\\n              <div\\n                key={item.id}\\n                className=\\\"rounded-2xl bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800 hover:border-indigo-500/50 p-5 space-y-4 flex flex-col justify-between shadow-lg transition\\\"\\n              >\\n                <div className=\\\"space-y-3\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span\\n                      className={`text-[10px] font-bold px-2 py-0.5 rounded ${\\n                        item.tierCode === \'TIER_A\'\\n                          ? \'bg-indigo-500/20 text-indigo-300 border border-indigo-500/30\'\\n                          : \'bg-amber-500/20 text-amber-300 border border-amber-500/30\'\\n                      }`}\\n                    >\\n                      {item.tierCode.replace(\'_\', \' \')}\\n                    </span>\\n                    <span className=\\\"text-xs text-slate-400 flex items-center space-x-1\\\">\\n                      <Clock className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>{item.durationMins} mins</span>\\n                    </span>\\n                  </div>\\n\\n                  <div>\\n                    <h4 className=\\\"text-base font-bold text-white leading-tight\\\">{item.trackName}</h4>\\n                    <p className=\\\"text-xs text-slate-400 mt-0.5\\\">{item.roundName}</p>\\n                  </div>\\n\\n                  <div className=\\\"p-3 rounded-xl bg-slate-950 text-xs space-y-1 border border-slate-800/80\\\">\\n                    <div className=\\\"flex justify-between text-slate-300\\\">\\n                      <span>Target Role:</span>\\n                      <span className=\\\"font-medium text-white\\\">{item.jobRole}</span>\\n                    </div>\\n                    <div className=\\\"flex justify-between text-slate-300\\\">\\n                      <span>Coding Language:</span>\\n                      <span className=\\\"font-medium text-white\\\">{item.preferredLanguage}</span>\\n                    </div>\\n                    <div className=\\\"flex justify-between text-slate-300 pt-1 border-t border-slate-800\\\">\\n                      <span>Your Earnings (80%):</span>\\n                      <span className=\\\"font-extrabold text-emerald-400 text-sm\\\">\\n                        \342\202\271{item.expectedCompensation}.00\\n                      </span>\\n                    </div>\\n                  </div>\\n                </div>\\n\\n                <button\\n                  onClick={() => handleClaimSession(item.bookingId)}\\n                  disabled={!isApproved || claimingId === item.bookingId}\\n                  className=\\\"w-full py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 disabled:opacity-40 text-white font-bold text-xs shadow-md shadow-indigo-600/30 transition flex items-center justify-center space-x-1.5\\\"\\n                >\\n                  {claimingId === item.bookingId ? (\\n                    <span>Claiming session...</span>\\n                  ) : !isApproved ? (\\n                    <span className=\\\"flex items-center space-x-1\\\">\\n                      <Lock className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Approval Required</span>\\n                    </span>\\n                  ) : (\\n                    <>\\n                      <span>Accept & Claim Session (\342\202\271{item.expectedCompensation})</span>\\n                      <ArrowRight className=\\\"w-4 h-4\\\" />\\n                    </>\\n                  )}\\n                </button>\\n              </div>\\n            ))}\\n          </div>\\n        )}\\n      </div>\\n\\n      {/* Earnings & Financial Accounting */}\\n      <div className=\\\"space-y-4\\\">\\n        <div className=\\\"flex items-center justify-between\\\">\\n          <h2 className=\\\"text-lg font-bold text-white flex items-center space-x-2\\\">\\n            <Wallet className=\\\"w-5 h-5 text-emerald-400\\\" />\\n            <span>Earnings & Payout Ledger</span>\\n          </h2>\\n\\n          {earnings && earnings.availableBalance > 0 && (\\n            <button\\n              onClick={() => setShowPayoutModal(true)}\\n              className=\\\"px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-md transition\\\"\\n            >\\n              Withdraw Earnings (\342\202\271{earnings.availableBalance})\\n            </button>\\n          )}\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-4 gap-4\\\">\\n          <div className=\\\"p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-1\\\">\\n            <div className=\\\"text-xs text-slate-400\\\">Available Balance</div>\\n            <div className=\\\"text-2xl font-extrabold text-emerald-400\\\">\\n              \342\202\271{earnings?.availableBalance || 0}.00\\n            </div>\\n            <div className=\\\"text-[11px] text-slate-500\\\">Ready for instant UPI payout</div>\\n          </div>\\n\\n          <div className=\\\"p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-1\\\">\\n            <div className=\\\"text-xs text-slate-400\\\">Pending Review</div>\\n            <div className=\\\"text-2xl font-extrabold text-amber-400\\\">\\n              \342\202\271{earnings?.pendingBalance || 0}.00\\n            </div>\\n            <div className=\\\"text-[11px] text-slate-500\\\">Awaiting feedback submission</div>\\n          </div>\\n\\n          <div className=\\\"p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-1\\\">\\n            <div className=\\\"text-xs text-slate-400\\\">Total Paid Out</div>\\n            <div className=\\\"text-2xl font-extrabold text-slate-200\\\">\\n              \342\202\271{earnings?.paidBalance || 0}.00\\n            </div>\\n            <div className=\\\"text-[11px] text-slate-500\\\">Transferred to UPI / Bank</div>\\n          </div>\\n\\n          <div className=\\\"p-5 rounded-2xl bg-slate-900 border border-slate-800 space-y-1\\\">\\n            <div className=\\\"text-xs text-slate-400\\\">Lifetime Earnings</div>\\n            <div className=\\\"text-2xl font-extrabold text-white\\\">\\n              \342\202\271{earnings?.totalEarned || 0}.00\\n            </div>\\n            <div className=\\\"text-[11px] text-slate-500\\\">{profile?.totalCompletedSessions || 0} completed interviews</div>\\n          </div>\\n        </div>\\n\\n        {/* Payout History */}\\n        {earnings && earnings.payoutHistory.length > 0 && (\\n          <div className=\\\"rounded-2xl bg-slate-900 border border-slate-800 p-5 space-y-3\\\">\\n            <h3 className=\\\"text-xs font-bold text-slate-300 uppercase tracking-wider\\\">\\n              Recent Payout Transfers\\n            </h3>\\n            <div className=\\\"divide-y divide-slate-800 text-xs\\\">\\n              {earnings.payoutHistory.map((p) => (\\n                <div key={p.id} className=\\\"py-2.5 flex items-center justify-between text-slate-300\\\">\\n                  <div>\\n                    <div className=\\\"font-semibold text-white\\\">{p.payoutRef}</div>\\n                    <div className=\\\"text-[10px] text-slate-500\\\">\\n                      Destination: {p.destination} \342\200\242 Ref: {p.referenceCode}\\n                    </div>\\n                  </div>\\n                  <div className=\\\"text-right\\\">\\n                    <span className=\\\"font-bold text-emerald-400 text-sm\\\">\342\202\271{p.amount}.00</span>\\n                    <div className=\\\"text-[10px] text-slate-400\\\">\\n                      {new Date(p.createdAt).toLocaleDateString([], { month: \'short\', day: \'numeric\', year: \'numeric\' })}\\n                    </div>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n\\n      {/* Payout Modal */}\\n      {showPayoutModal && (\\n        <div className=\\\"fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4\\\">\\n          <div className=\\\"bg-slate-900 border border-slate-700 rounded-3xl w-full max-w-md p-6 space-y-5 shadow-2xl\\\">\\n            <div className=\\\"flex justify-between items-center\\\">\\n              <h3 className=\\\"text-base font-bold text-white\\\">Request Interviewer Payout</h3>\\n              <button\\n                onClick={() => setShowPayoutModal(false)}\\n                className=\\\"text-slate-400 hover:text-white\\\"\\n              >\\n                \342\234\225\\n              </button>\\n            </div>\\n\\n            <form onSubmit={handleRequestPayout} className=\\\"space-y-4\\\">\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-slate-300 mb-1\\\">\\n                  Withdrawal Amount (Max: \342\202\271{earnings?.availableBalance}):\\n                </label>\\n                <input\\n                  type=\\\"number\\\"\\n                  min=\\\"1\\\"\\n                  max={earnings?.availableBalance}\\n                  value={payoutAmount}\\n                  onChange={(e) => setPayoutAmount(e.target.value)}\\n                  placeholder={`e.g. ${earnings?.availableBalance}`}\\n                  required\\n                  className=\\\"w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-white text-sm focus:outline-none focus:border-indigo-500\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-slate-300 mb-1\\\">\\n                  UPI ID or Bank Account:\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={payoutUpi}\\n                  onChange={(e) => setPayoutUpi(e.target.value)}\\n                  placeholder=\\\"e.g. name@okhdfcbank\\\"\\n                  required\\n                  className=\\\"w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-white text-sm focus:outline-none focus:border-indigo-500\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"p-3 rounded-xl bg-slate-950 border border-slate-800 text-[11px] text-slate-400\\\">\\n                Processed via simulated NEFT / IMPS gateway. Updates the append-only financial ledger immediately.\\n              </div>\\n\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={isProcessingPayout}\\n                className=\\\"w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white font-bold text-xs shadow-md transition\\\"\\n              >\\n                {isProcessingPayout ? \'Processing transfer...\' : \'Confirm Transfer\'}\\n              </button>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create InterviewerDashboard with live queue radar, atomic claiming, availability toggle, and earnings payout ledger\", \"Overwrite\":true, \"TargetFile\":\"/src/components/InterviewerDashboard.tsx\", \"toolAction\":\"Writing file\", \"toolSummary\":\"Create Interviewer Dashboard\"}"
      thinking_signature: "\022\202\f\n\377\v\001i\024}\023+xY\244~]-\252\250CC\243=\026\004\024\301\241\232\270\r\3358$\300\365\2315k\277\223<<3\336G\aG:/\'\374\347w\260z{w\361\363kFm\337c\022\3774\001Ag\367v(\003\340\246\373\367y\231\304\353\324\246\346\ao\333\262\276\304\006\022\360\232u\270M$\341\257:\371\373\273\205\254\032\214\023\177\203\255\256l\211\301\004@\277\"\326|\254\035\366Z#\210\263\374<\203\223\312z\232\355VbO\003\327Bt\200*o\376x\304\342\243\264\323\033x\275\203\217\247\336\005\320\351~j0\327tn\301\330\357+\024\357\347\372K\267\263\377\207\321\362\332\223\002\327\305\205\300\352}\220T\214LAAuF<\212\325?\314\325\024M$D5:\245\006f\346v\030\300\211%\342\002a\370R\375`A,\366#DTb`\364\222\035\27263\017\rT\240b\253\a2\206\237\375\263\213\177H\344\330I\255\274C\340\203\360\373V\330=\366\343\206\363\266#\270+\236\231\252?l\276L@\226S\302r,\177~\352TOY\'\246D8M\346\270\b\000\237p\260;\032\256L\25263\253\315\321\030(\231\222\345\377\312\332b;\006&\033h\260\034\373\234\214 \223\211\336|\'\360\276\030\354\036DnX\034I\021\237\316\305\031c\316\b\301B\005N\213\366\355\210Ep\321\351*\216T_Nn\027g\264\233\331{\336Ov\000!S\221G\031\307\340\340\"$0Xb\376`\276*p)\232Lb\002\003\003\250?\3121\360N\346\346\226\211&\373q\207M\341F;\352\3640\"\310\247l\347\322<Jt\211\327$Z\357\003VM\366\026`\020J\024 r\002\254\332#\212\220\267\225\255\223h\247\370\002uB\334\000s\037\016\345\230\210\235a\213\177U\003\321\355\177\"\r,8\352\262\366\233\342\030\0224\364SW\367\2217\005\250-\355\244\252A\305\017\357d$R\261\205\212\230\312\311\002\2268\267\333\306\332Z\274\301\r\245]\245\335\340\335V\272h\214\264\017.\031\353m\002*T>\033/\034\301\377\351_\'\345\035\351e\263?\016q\220&R\360Mj\275\306\376\036C\350\234(8v\372&\236G\b\331\363e\2461x\331\352\247\271d\023\367kP\031\333<\253\275\nl\031\230\334yXt\222<\270\304\240t\236\305\324V_\253G\376\211\265\361\321\177\213J \'\377\351\373\237\277\3742\335\324\347\361P\272\235F\201\341\303X\ry^g\335u\203b\215\032\032@\316kI\231\022\231`\347\316\271\22486M\002?\271.\211\000\351\327\021\025\347$T\212\312\344\032a\216\350-\253\323\230\377B\257#\327\236\266\335)\375\345\223\207\231Q\b\351b\2108_0[dvI\350u\276\332\037b\323\362\024\006\345h\303\016(\']\357\325z\363u\027\277RY\325\204U\v\253<\'\t\373\234\342\n \177\227\207\2463\311\214\260\250\237\252*\003\025\r\313\345\247,\272ok\361\320\362\340\006\255\237\202\375q\231\234\213\342B\241\343\356h\020@>\237(\244^\022h\301[\262\263<\024O\244\304\321gS\200}\031!\302\243\230`\360\034\f\026\207\202\376i\314w\275\354!\366\232\2432\024\022\355\371/r<\210\261\2166\006\017\032b\352\n\001\245y\266do\016\205!\316\'~\246\354\214ie\0265\205\301\205P\353z\241\032?\360\265\2350\342m\273,\037\'\326\372J\232\205\372#U\373)\036\\\376\372\305\260@\366\244v\360\324\306QP\303j^\255\214\241}d\207\304J\374\331Kv4\312\n\361\336\000\274 \370\206\344\360\032\255\b\236\263W\373F\267p\265\234\211\351\2449\323B{E\377\220\212\367O\227\237^$\034\355y\334\204kp_\200\260\234Mv|\312Gr\332\353h\260\277\344g\356\340\001\030\373\036\270qV_5\336\326\fL\237\300G\016\r\034\2573\266R=\021\361\3604\332\213\v\027W\361\235/\254|\027\224:\247\272!Z\327\0061\a\aQ\250\262\260\250<\226kV\177\273\371\363\272\326Z\022\245L{1\341\321z\212\252\262\2056\351\004]^\006\325\030\020\312\346*\343\374t\v\026Qn\314/\330JdK\353-\002E\211\235\227\337\253\351_\231\226\336G\312\276=\270;\241+\003\032\343\006g#\203<\253X\345v\347\373\206\250\343\331\276\270!De\260a\251\016Cva\376_1wEOP\225\320\255,h\270*3\fcBk\327\273\212b}\001y\316#\342\245\325\304\246\2512u@L3<|\035\332\t\344\210wU\304\004X\031\311s\214\303m\\M\365\374I\2761Lc#\233\035\340\305\372:u\246uRlG\377O\264\243\375~\360\023}E\002\3630f5\256\231e\274ik\221\344$\251\223G\317\327\a\304\347\215q\033\005)3\031~^\374W/\307}\332\232C\023A\223\220s\270n\\\324\212x\303!\034\003\357\a\223$\326\251j\\\023\277|ue\324-\001~\247s\b\246\236\036sJ\356\031\376\016\345i\347\311\346\204\255\327\230 \006\253y\223a=\037\261\0379~\304ln\233#|\003\360\270\251\"\350\034\021\002\212d\2613\025OQ\