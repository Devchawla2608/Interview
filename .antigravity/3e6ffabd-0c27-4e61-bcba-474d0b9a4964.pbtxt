  planner_response {
    thinking: "**Defining Data Types**\n\nI\'m now focused on establishing the fundamental data structures. My primary task involves creating `src/types/index.ts`. I plan to define every data type required for Interview Arena, encompassing Candidate, Interviewer, Admin, and more. This includes Tiers, Rounds, Bookings, Queue, Payments, Ledger, Feedbacks, and Settings. My aim is to build a solid and complete data foundation.\n\n\n"
    tool_calls {
      id: "call_850306"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"export type UserRole = \'CANDIDATE\' | \'INTERVIEWER\' | \'ADMIN\';\\n\\nexport interface User {\\n  id: string;\\n  email: string;\\n  fullName: string;\\n  avatarUrl?: string;\\n  roles: UserRole[];\\n  activeRole: UserRole;\\n  isSuspended: boolean;\\n  emailVerified: boolean;\\n  createdAt: string;\\n  candidateProfile?: CandidateProfile;\\n  interviewerProfile?: InterviewerProfile;\\n}\\n\\nexport interface CandidateProfile {\\n  id: string;\\n  userId: string;\\n  targetRoles: string[];\\n  experienceLevel: \'STUDENT\' | \'FRESHER\' | \'1-3_YEARS\' | \'3-5_YEARS\' | \'5+_YEARS\';\\n  graduationYear?: number;\\n  collegeOrEmployer?: string;\\n  bio?: string;\\n  preferredLanguages: string[];\\n  timezone: string;\\n  totalSessions: number;\\n  totalSpent: number;\\n}\\n\\nexport type InterviewerStatus =\\n  | \'DRAFT\'\\n  | \'SUBMITTED\'\\n  | \'SCREENING_REQUIRED\'\\n  | \'UNDER_REVIEW\'\\n  | \'APPROVED\'\\n  | \'REJECTED\'\\n  | \'SUSPENDED\';\\n\\nexport interface InterviewerProfile {\\n  id: string;\\n  userId: string;\\n  headline: string;\\n  bio: string;\\n  experienceYears: number;\\n  collegeOrEmployer: string;\\n  currentCompany?: string;\\n  currentRole?: string;\\n  skills: string[];\\n  preferredTiers: (\'TIER_A\' | \'TIER_B\' | \'TIER_C\')[];\\n  languages: string[];\\n  status: InterviewerStatus;\\n  isAvailable: boolean;\\n  ratingAvg: number;\\n  ratingCount: number;\\n  totalCompletedSessions: number;\\n  bankAccountMask?: string;\\n  upiId?: string;\\n  reviewerNotes?: string;\\n}\\n\\nexport interface InterviewerApplication {\\n  id: string;\\n  userId: string;\\n  userEmail: string;\\n  userName: string;\\n  status: InterviewerStatus;\\n  submittedAt: string;\\n  resumeUrl?: string;\\n  yearsOfExperience: number;\\n  skills: string[];\\n  currentCompany: string;\\n  screening1: {\\n    status: \'PENDING\' | \'SCHEDULED\' | \'COMPLETED\' | \'FAILED\';\\n    interviewerName?: string;\\n    scheduledAt?: string;\\n    score?: number;\\n    notes?: string;\\n  };\\n  screening2: {\\n    status: \'PENDING\' | \'SCHEDULED\' | \'COMPLETED\' | \'FAILED\';\\n    interviewerName?: string;\\n    scheduledAt?: string;\\n    score?: number;\\n    notes?: string;\\n  };\\n  adminNotes?: string;\\n  reviewedAt?: string;\\n}\\n\\nexport type TierCode = \'TIER_A\' | \'TIER_B\' | \'TIER_C\';\\n\\nexport interface Tier {\\n  id: string;\\n  code: TierCode;\\n  name: string;\\n  badge: string;\\n  price: number; // in INR (\342\202\271)\\n  description: string;\\n  commissionPercent: number; // e.g. 20%\\n  defaultRoundCount: number;\\n  order: number;\\n  isActive: boolean;\\n}\\n\\nexport interface CompanyTrack {\\n  id: string;\\n  tierCode: TierCode;\\n  name: string;\\n  slug: string;\\n  description: string;\\n  badge: string;\\n  recommendedRounds: number;\\n  isActive: boolean;\\n}\\n\\nexport interface RoundTemplate {\\n  id: string;\\n  tierCode: TierCode;\\n  trackId?: string;\\n  roundNumber: number;\\n  name: string;\\n  description: string;\\n  durationMins: number;\\n  price: number;\\n  difficulty: \'ENTRY\' | \'MEDIUM\' | \'HARD\' | \'EXPERT\';\\n  topics: string[];\\n  rubricCriteria: string[];\\n  isActive: boolean;\\n}\\n\\nexport type BookingStatus =\\n  | \'AWAITING_PAYMENT\'\\n  | \'PAID\'\\n  | \'QUEUED\'\\n  | \'CLAIMED\'\\n  | \'SCHEDULED\'\\n  | \'READY\'\\n  | \'IN_PROGRESS\'\\n  | \'COMPLETED\'\\n  | \'CANCELLED\'\\n  | \'REFUND_PENDING\'\\n  | \'REFUNDED\'\\n  | \'NO_SHOW_CANDIDATE\'\\n  | \'NO_SHOW_INTERVIEWER\'\\n  | \'DISPUTED\';\\n\\nexport interface Booking {\\n  id: string;\\n  bookingRef: string;\\n  candidateId: string;\\n  candidateName: string;\\n  candidateEmail: string;\\n  interviewerId?: string;\\n  interviewerName?: string;\\n  tierCode: TierCode;\\n  trackName: string;\\n  roundName: string;\\n  roundNumber: number;\\n  roundDurationMins: number;\\n  bookingType: \'QUEUE\' | \'SCHEDULED\';\\n  status: BookingStatus;\\n  scheduledAt?: string;\\n  preferredLanguage: string;\\n  jobRole: string;\\n  price: number;\\n  platformFee: number;\\n  totalAmount: number;\\n  interviewerEarnings: number;\\n  paymentOrderId?: string;\\n  paymentStatus: \'UNPAID\' | \'PAID\' | \'REFUNDED\';\\n  meetingUrl?: string;\\n  meetingProvider: \'GOOGLE_MEET\' | \'DEV_FALLBACK_SANDBOX\';\\n  cancellationReason?: string;\\n  createdAt: string;\\n  updatedAt: string;\\n}\\n\\nexport interface QueueEntry {\\n  id: string;\\n  bookingId: string;\\n  candidateId: string;\\n  candidateName: string;\\n  tierCode: TierCode;\\n  trackName: string;\\n  roundName: string;\\n  roundNumber: number;\\n  jobRole: string;\\n  durationMins: number;\\n  preferredLanguage: string;\\n  expectedCompensation: number;\\n  status: \'WAITING\' | \'CLAIMED\' | \'TIMEOUT\' | \'CANCELLED\';\\n  enteredAt: string;\\n  timeoutAt: string;\\n  claimedBy?: string;\\n  claimedAt?: string;\\n}\\n\\nexport interface InterviewerAvailabilitySlot {\\n  id: string;\\n  interviewerId: string;\\n  dayOfWeek: number; // 0 = Sunday, 1 = Monday, etc.\\n  startTime: string; // \\\"14:00\\\"\\n  endTime: string; // \\\"18:00\\\"\\n  isActive: boolean;\\n}\\n\\nexport interface PaymentOrder {\\n  id: string;\\n  orderRef: string;\\n  bookingId: string;\\n  userId: string;\\n  amount: number;\\n  currency: string;\\n  status: \'CREATED\' | \'CAPTURED\' | \'FAILED\' | \'REFUNDED\';\\n  provider: \'RAZORPAY_TEST\' | \'RAZORPAY_LIVE\' | \'DEV_MOCK\';\\n  providerOrderId: string;\\n  providerPaymentId?: string;\\n  signature?: string;\\n  createdAt: string;\\n}\\n\\nexport interface Refund {\\n  id: string;\\n  refundRef: string;\\n  bookingId: string;\\n  amount: number;\\n  reason: string;\\n  status: \'PENDING\' | \'APPROVED\' | \'PROCESSED\' | \'REJECTED\';\\n  initiatedBy: string;\\n  adminNotes?: string;\\n  providerRefundId?: string;\\n  createdAt: string;\\n  processedAt?: string;\\n}\\n\\nexport type LedgerEntryType =\\n  | \'PAYMENT_RECEIVED\'\\n  | \'PLATFORM_COMMISSION\'\\n  | \'INTERVIEWER_CREDIT\'\\n  | \'REFUND_DEBIT\'\\n  | \'PAYOUT_DEBIT\'\\n  | \'ADMIN_ADJUSTMENT\';\\n\\nexport interface LedgerEntry {\\n  id: string;\\n  bookingId?: string;\\n  userId?: string;\\n  type: LedgerEntryType;\\n  amount: number; // positive = credit, negative = debit\\n  balanceAfter: number;\\n  description: string;\\n  referenceId: string;\\n  createdAt: string;\\n}\\n\\nexport interface InterviewerEarnings {\\n  interviewerId: string;\\n  pendingBalance: number;\\n  availableBalance: number;\\n  paidBalance: number;\\n  totalEarned: number;\\n  payoutHistory: PayoutRecord[];\\n}\\n\\nexport interface PayoutRecord {\\n  id: string;\\n  payoutRef: string;\\n  amount: number;\\n  status: \'PENDING\' | \'PROCESSED\' | \'FAILED\';\\n  destination: string;\\n  referenceCode?: string;\\n  createdAt: string;\\n  processedAt?: string;\\n}\\n\\nexport interface FeedbackCriterionScore {\\n  criterion: string;\\n  score: number; // 1 to 5\\n  comments: string;\\n}\\n\\nexport interface InterviewFeedback {\\n  id: string;\\n  bookingId: string;\\n  interviewerId: string;\\n  interviewerName: string;\\n  candidateId: string;\\n  criteriaScores: FeedbackCriterionScore[];\\n  overallScore: number;\\n  strengths: string;\\n  improvementAreas: string;\\n  recommendedTopics: string[];\\n  recommendedNextRound: string;\\n  practiceReadiness: \'NEEDS_PRACTICE\' | \'DEVELOPING\' | \'JOB_READY\' | \'EXCELLENT\';\\n  submittedAt: string;\\n}\\n\\nexport interface CandidateReview {\\n  id: string;\\n  bookingId: string;\\n  candidateId: string;\\n  interviewerId: string;\\n  rating: number; // 1 to 5\\n  comment: string;\\n  createdAt: string;\\n}\\n\\nexport interface DisputeReport {\\n  id: string;\\n  bookingId: string;\\n  raisedByUserId: string;\\n  raisedByRole: UserRole;\\n  reason: string;\\n  description: string;\\n  status: \'OPEN\' | \'INVESTIGATING\' | \'RESOLVED_REFUND\' | \'RESOLVED_DISMISSED\';\\n  adminNotes?: string;\\n  createdAt: string;\\n  resolvedAt?: string;\\n}\\n\\nexport interface NotificationItem {\\n  id: string;\\n  userId: string;\\n  title: string;\\n  message: string;\\n  type: \'INFO\' | \'SUCCESS\' | \'WARNING\' | \'ALERT\';\\n  isRead: boolean;\\n  link?: string;\\n  createdAt: string;\\n}\\n\\nexport interface AdminAuditLog {\\n  id: string;\\n  adminId: string;\\n  adminEmail: string;\\n  action: string;\\n  targetType: string;\\n  targetId: string;\\n  details: string;\\n  ipAddress: string;\\n  createdAt: string;\\n}\\n\\nexport interface AppSettings {\\n  commissionPercent: number;\\n  queueTimeoutMinutes: number;\\n  claimTimeoutMinutes: number;\\n  autoRefundOnTimeout: boolean;\\n  razorpayKeyId: string;\\n  razorpayKeySecretConfigured: boolean;\\n  googleMeetConfigured: boolean;\\n  emailConfigured: boolean;\\n  platformNotice: string;\\n}\\n\\nexport interface PlatformMetrics {\\n  totalUsers: number;\\n  candidateCount: number;\\n  interviewerCount: number;\\n  approvedInterviewersCount: number;\\n  totalBookings: number;\\n  completedSessions: number;\\n  activeQueueCount: number;\\n  grossPaymentVolume: number;\\n  platformCommissionRevenue: number;\\n  interviewerLiabilities: number;\\n  totalRefunds: number;\\n  averageRating: number;\\n  timeoutRate: number;\\n  noShowRate: number;\\n}\\n\", \"Description\":\"Create comprehensive TypeScript type definitions for Interview Arena\", \"Overwrite\":true, \"TargetFile\":\"/src/types/index.ts\", \"toolAction\":\"Writing file\", \"toolSummary\":\"Create TypeScript types\"}"
