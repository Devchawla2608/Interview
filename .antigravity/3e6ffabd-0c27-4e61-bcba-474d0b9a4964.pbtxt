  view_file {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    start_line: 104
    end_line: 189
    content: "            onClick={() => setActiveTab(\'candidate-dashboard\')}\n            className=\"flex items-center space-x-3 text-left focus:outline-none\"\n          >\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-indigo-500 to-amber-500 flex items-center justify-center font-bold text-white shadow-lg shadow-indigo-500/20\">\n              IA\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"font-extrabold text-lg tracking-tight bg-gradient-to-r from-white via-slate-100 to-slate-400 bg-clip-text text-transparent\">\n                  Interview Arena\n                </span>\n                <span className=\"text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30\">\n                  LIVE\n                </span>\n              </div>\n              <p className=\"text-[11px] text-slate-400 hidden sm:block\">\n                Tier-based Mock Interviews \342\200\242 Real Matchmaking\n              </p>\n            </div>\n          </button>\n\n          {/* Nav links */}\n          <nav className=\"hidden md:flex items-center space-x-1\">\n            <button\n              onClick={() => setActiveTab(\'catalog\')}\n              className={`px-3 py-2 rounded-lg text-sm font-medium transition ${\n                activeTab === \'catalog\'\n                  ? \'bg-slate-800 text-indigo-400\'\n                  : \'text-slate-300 hover:text-white hover:bg-slate-800/60\'\n              }`}\n            >\n              <span className=\"flex items-center space-x-1.5\">\n                <Layers className=\"w-4 h-4\" />\n                <span>Interview Tracks</span>\n              </span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'candidate-dashboard\')}\n              className={`px-3 py-2 rounded-lg text-sm font-medium transition ${\n                activeTab === \'candidate-dashboard\'\n                  ? \'bg-slate-800 text-indigo-400\'\n                  : \'text-slate-300 hover:text-white hover:bg-slate-800/60\'\n              }`}\n            >\n              <span className=\"flex items-center space-x-1.5\">\n                <Compass className=\"w-4 h-4\" />\n                <span>Candidate Arena</span>\n              </span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'interviewer-dashboard\')}\n              className={`px-3 py-2 rounded-lg text-sm font-medium transition ${\n                activeTab === \'interviewer-dashboard\'\n                  ? \'bg-slate-800 text-amber-400\'\n                  : \'text-slate-300 hover:text-white hover:bg-slate-800/60\'\n              }`}\n            >\n              <span className=\"flex items-center space-x-1.5\">\n                <Briefcase className=\"w-4 h-4\" />\n                <span>Interviewer Portal</span>\n              </span>\n            </button>\n\n            {currentUser?.roles.includes(\'ADMIN\') && (\n              <button\n                onClick={() => setActiveTab(\'admin-dashboard\')}\n                className={`px-3 py-2 rounded-lg text-sm font-medium transition ${\n                  activeTab === \'admin-dashboard\'\n                    ? \'bg-slate-800 text-rose-400\'\n                    : \'text-slate-300 hover:text-white hover:bg-slate-800/60\'\n                }`}\n              >\n                <span className=\"flex items-center space-x-1.5\">\n                  <ShieldAlert className=\"w-4 h-4\" />\n                  <span>Admin Panel</span>\n                </span>\n              </button>\n            )}\n          </nav>\n        </div>\n\n        {/* Right side tools */}\n        <div className=\"flex items-center space-x-3\">\n          {/* Active Queue pill */}"
    num_lines: 429
