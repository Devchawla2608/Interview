        target_content: "        {/* Left Column: Meeting room & details */}\n        <div className=\"lg:col-span-7 space-y-6\">\n          {/* Meeting Room Card */}\n          <div className=\"rounded-3xl bg-slate-900 border border-slate-800 p-6 space-y-5 shadow-xl\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center space-x-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-indigo-600/20 text-indigo-400 flex items-center justify-center\">\n                  <Video className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <h3 className=\"text-base font-bold text-white\">Live Meeting Conference</h3>\n                  <p className=\"text-xs text-slate-400\">\n                    Provider:{\' \'}\n                    <span className=\"text-indigo-300 font-medium\">\n                      {booking.meetingProvider === \'GOOGLE_MEET\'\n                        ? \'Google Meet (Calendar API)\'\n                        : \'Dev Video Sandbox (Jitsi)\'}\n                    </span>\n                  </p>\n                </div>\n              </div>\n\n              <span className=\"text-[11px] font-bold px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30\">\n                MEETING READY\n              </span>\n            </div>\n\n            {/* Provider notice */}\n            {booking.meetingProvider === \'DEV_FALLBACK_SANDBOX\' && (\n              <div className=\"p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-[11px] text-slate-400 space-y-1\">\n                <div className=\"text-indigo-400 font-semibold flex items-center space-x-1.5\">\n                  <ShieldAlert className=\"w-3.5 h-3.5\" />\n                  <span>Development Fallback Enabled</span>\n                </div>\n                <p>\n                  Google Calendar OAuth credentials are not configured in `.env`. The platform automatically provisions a real-time web video room so you can immediately conduct the practice interview without interruptions.\n                </p>\n              </div>\n            )}\n\n            <div className=\"p-5 rounded-2xl bg-slate-950 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n              <div>\n                <div className=\"text-xs text-slate-400\">Encrypted Meeting URL:</div>\n                <div className=\"text-sm font-mono text-indigo-300 truncate max-w-sm mt-0.5\">\n                  {booking.meetingUrl}\n                </div>\n              </div>\n\n              <a\n                href={booking.meetingUrl}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs shadow-md shadow-indigo-600/30 transition flex items-center justify-center space-x-2 shrink-0\"\n              >\n                <span>Join Meeting Call</span>\n                <ExternalLink className=\"w-4 h-4\" />\n              </a>\n            </div>"
        replacement_content: "        {/* Left Column: Meeting room & details */}\n        <div className=\"lg:col-span-7 space-y-6\">\n          {isInCall ? (\n            <InHouseMeetingRoom\n              booking={booking}\n              currentUser={currentUser}\n              onEndCall={() => setIsInCall(false)}\n            />\n          ) : (\n            /* Meeting Room Card */\n            <div className=\"rounded-3xl bg-slate-900 border border-slate-800 p-6 space-y-5 shadow-xl\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center space-x-3\">\n                  <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-indigo-600 text-white flex items-center justify-center shadow-lg\">\n                    <Video className=\"w-5 h-5\" />\n                  </div>\n                  <div>\n                    <h3 className=\"text-base font-bold text-white\">In-House Video Meeting</h3>\n                    <p className=\"text-xs text-slate-400\">\n                      Zero 3rd party apps required \342\200\242 Embedded WebRTC & Live Problem Runner\n                    </p>\n                  </div>\n                </div>\n\n                <span className=\"text-[11px] font-bold px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30\">\n                  READY TO CONNECT\n                </span>\n              </div>\n\n              <div className=\"p-4 rounded-2xl bg-gradient-to-r from-emerald-950/30 to-indigo-950/30 border border-emerald-500/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                <div className=\"space-y-1\">\n                  <div className=\"text-xs font-bold text-white flex items-center space-x-1.5\">\n                    <Cast className=\"w-4 h-4 text-emerald-400\" />\n                    <span>Arena Meet Built-in Video Call</span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-300\">\n                    Dual video streams, microphone controls, screen sharing, in-call chat, and live code sandbox.\n                  </p>\n                </div>\n\n                <button\n                  onClick={() => setIsInCall(true)}\n                  className=\"px-5 py-3 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs shadow-lg shadow-emerald-600/30 transition flex items-center justify-center space-x-2 shrink-0 animate-pulse\"\n                >\n                  <Video className=\"w-4 h-4\" />\n                  <span>Launch In-House Call</span>\n                </button>\n              </div>\n\n              <div className=\"p-4 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-between text-xs\">\n                <div>\n                  <div className=\"text-slate-400\">Room Identifier:</div>\n                  <div className=\"font-mono text-indigo-300 font-bold\">{booking.bookingRef}</div>\n                </div>\n                <div className=\"text-right text-slate-400\">\n                  <div>Security:</div>\n                  <div className=\"text-emerald-400 font-semibold\">Peer-to-Peer Encrypted</div>\n                </div>\n              </div>"
