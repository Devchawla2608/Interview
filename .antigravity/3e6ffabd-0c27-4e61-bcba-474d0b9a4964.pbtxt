      thinking_signature: "\022\317\023\n\314\023\001i\024}\023\004\351\351\262\331\035\035\256\304\030g\326\202h\177\223\346\316\341\3052%\316H\325\255\342d\034\252y\356\360\220\220\265\360(\232\262\311\311|X\025\272a\362E\3121M\236\031pV\241\a\035M)\364^\374\3136\331\004o\r\367\270G0 \353c\317a9\242\212\027MK%\345\277\033>g\336\023\035#\034\237\323\343Ih&A\274c\366\316\247pm\331;\355\340m$\340Q8\310lV\360ls\274u\ak\230\246A\237\262\031\263\304\006\262W\253\212\334\354\231,\301)\323\333\374\017\'=\3363~\235\345k[\273\332\242i\254\003\360j[T\026&^\373Mb\017\300eI7\350Z}\336\001\255k\373Cz\335\2569\332?\371G\357\231\345\2308?\tV\261\211\263lx\225,\345\004\330\234\374U\266av\254\323\245\315\017A\201\2625I\220\235\334\273\267\344\205\252}J\355~] P\255\357_\021\315\017\336?\002\264\300/!}\303\315\270\203\036\2369\005\001\341\253\214F\230\210\3476\206\225V1\364%X\322\030wz\370\204\260\343\017\317\0229Z\375>J\244\233\315\244\3704*4&\265\202.\203\270K\276\226\302\003m\326\201\253/\347\374W5G]\261\244Ku\006\324\202V\353\337\271\266\032*\213U.\234\2526\235\033\354I\372}E\237W\370P>\224\334\021l\001\304\020t*7\177\300\334n\321G\336\203 :\vo^\260\324\037A\233$\322\377/W\235\036\334\326\032\261\312xp\3637m\266\r\3143\343?\242\017\234\310K`Jn\345Bo\316\361y\201\200\310z\207cOU\244a\327\335yZ\370\350\264`U\253\250N\252\325\v\a\340\030q\257\324\226\266\243\\\036\n\322\016A]\223!R\342\225\207\225\024\033X\331i\345\024\222\031\362\356x?\376h\001\331\374tI\321\233*\222\351\215<\026\244\001\001\036\360\263\373\201\300\307w-\335>s\253[\003\340R\247b:\252N-\373S\262\\\314G\331\220S0\240z\360\200\2235\002\b\305U\'\325`A\235\240\207\350\360\fW\205\240\253#\276?\323+_c\221\254\375\3747\221\324\217>\253\227\002\226\250#\355=$8\2107Pr\320\331\235\245q\272\320U9J|\336\232\nS*\332o6\262E\213\023\310\327\302\252W03j$\2424\367\fG\270\313\237\332\256BTk\235W\276\027\340\346\375\023h\200\205\277\333\274\370*\225\256p\230K\0220\325K\001\020\372r{\224\271u%e}\332i\266b\346l\n\372#\200^\227f9\317\240