      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { Router } from \'express\';\\nimport { store } from \'../store\';\\n\\nexport const queueRouter = Router();\\n\\n// SSE Stream for real-time queue updates\\nqueueRouter.get(\'/stream\', (req, res) => {\\n  res.setHeader(\'Content-Type\', \'text/event-stream\');\\n  res.setHeader(\'Cache-Control\', \'no-cache\');\\n  res.setHeader(\'Connection\', \'keep-alive\');\\n  res.flushHeaders?.();\\n\\n  // Send initial state\\n  const initialData = JSON.stringify({\\n    type: \'INIT\',\\n    data: {\\n      queue: Array.from(store.queueEntries.values()).filter((q) => q.status === \'WAITING\'),\\n      activeCount: Array.from(store.queueEntries.values()).filter((q) => q.status === \'WAITING\').length,\\n    },\\n  });\\n  res.write(`data: ${initialData}\\\\n\\\\n`);\\n\\n  // Subscribe to changes\\n  const unsubscribe = store.subscribe((event) => {\\n    try {\\n      res.write(`data: ${JSON.stringify(event)}\\\\n\\\\n`);\\n    } catch {\\n      // client disconnected\\n    }\\n  });\\n\\n  req.on(\'close\', () => {\\n    unsubscribe();\\n  });\\n});\\n\\n// List eligible queue entries for interviewer\\nqueueRouter.get(\'/\', (req, res) => {\\n  const userId = (req.headers[\'x-user-id\'] as string) || \'usr_interviewer_1\';\\n  const interviewerProf = store.interviewerProfiles.get(userId);\\n\\n  // If approved interviewer, filter by preferred tiers and waiting status\\n  let waiting = Array.from(store.queueEntries.values())\\n    .filter((q) => q.status === \'WAITING\')\\n    .sort((a, b) => new Date(a.enteredAt).getTime() - new Date(b.enteredAt).getTime()); // FIFO\\n\\n  // Check queue timeouts\\n  const now = new Date().getTime();\\n  for (const q of waiting) {\\n    if (new Date(q.timeoutAt).getTime() < now) {\\n      q.status = \'TIMEOUT\';\\n      const b = store.bookings.get(q.bookingId);\\n      if (b && b.status === \'QUEUED\') {\\n        b.status = \'CANCELLED\';\\n        b.cancellationReason = \'Queue timeout: No interviewer accepted within timeout window.\';\\n        // Auto-refund on timeout\\n        if (store.settings.autoRefundOnTimeout && b.paymentStatus === \'PAID\') {\\n          b.status = \'REFUNDED\';\\n          b.paymentStatus = \'REFUNDED\';\\n          store.addLedgerEntry({\\n            bookingId: b.id,\\n            userId: b.candidateId,\\n            type: \'REFUND_DEBIT\',\\n            amount: -b.totalAmount,\\n            description: `Auto-refund for queue timeout on booking ${b.bookingRef}`,\\n            referenceId: \'REF-TIMEOUT-\' + b.bookingRef,\\n          });\\n          store.addNotification(\\n            b.candidateId,\\n            \'Queue Timeout & Full Refund Processed\',\\n            `No interviewer was available within the ${store.settings.queueTimeoutMinutes} min window. \342\202\271${b.totalAmount} was refunded in full.`,\\n            \'WARNING\'\\n          );\\n        }\\n      }\\n    }\\n  }\\n\\n  // Refresh waiting list\\n  waiting = Array.from(store.queueEntries.values())\\n    .filter((q) => q.status === \'WAITING\')\\n    .sort((a, b) => new Date(a.enteredAt).getTime() - new Date(b.enteredAt).getTime());\\n\\n  if (interviewerProf && interviewerProf.preferredTiers) {\\n    waiting = waiting.filter((q) => interviewerProf.preferredTiers.includes(q.tierCode));\\n  }\\n\\n  return res.json({\\n    queue: waiting,\\n    totalWaiting: waiting.length,\\n    isInterviewerApproved: interviewerProf?.status === \'APPROVED\',\\n  });\\n});\\n\\n// Candidate\'s active queue position\\nqueueRouter.get(\'/my\', (req, res) => {\\n  const userId = (req.headers[\'x-user-id\'] as string) || \'usr_candidate_1\';\\n\\n  const myEntry = Array.from(store.queueEntries.values()).find(\\n    (q) => q.candidateId === userId && q.status === \'WAITING\'\\n  );\\n\\n  if (!myEntry) {\\n    return res.json({ inQueue: false });\\n  }\\n\\n  // Calculate position in FIFO queue\\n  const allWaiting = Array.from(store.queueEntries.values())\\n    .filter((q) => q.status === \'WAITING\')\\n    .sort((a, b) => new Date(a.enteredAt).getTime() - new Date(b.enteredAt).getTime());\\n\\n  const position = allWaiting.findIndex((q) => q.id === myEntry.id) + 1;\\n  const estimatedWaitMins = Math.max(1, position * 3);\\n\\n  const booking = store.bookings.get(myEntry.bookingId);\\n\\n  return res.json({\\n    inQueue: true,\\n    entry: myEntry,\\n    booking,\\n    position,\\n    totalInQueue: allWaiting.length,\\n    estimatedWaitMins,\\n  });\\n});\\n\\n// Atomic Interviewer Acceptance\\nqueueRouter.post(\'/:bookingId/claim\', async (req, res) => {\\n  const userId = (req.headers[\'x-user-id\'] as string) || \'usr_interviewer_1\';\\n  const { bookingId } = req.params;\\n\\n  const result = await store.claimQueueEntryAtomic(bookingId, userId);\\n\\n  if (!result.success) {\\n    return res.status(409).json({ success: false, error: result.message });\\n  }\\n\\n  return res.json({ success: true, message: result.message, booking: result.booking });\\n});\\n\", \"Description\":\"Create queue router with SSE real-time streaming, FIFO ordering, timeout handling, and atomic claim\", \"Overwrite\":true, \"TargetFile\":\"/src/server/routes/queue.ts\", \"toolAction\":\"Writing file\", \"toolSummary\":\"Create queue routes\"}"
      thinking_signature: "\022\215\005\n\212\005\001i\024}\023g\257\240TJ#\367\035T\332\310\"\3654\b\"\253\342\221\316&7\026\246\377\333y>\363\223\215h\323\345\006\341\377\376\303U\227:\017n\211R\341=\a\005\316~|\314Fe\225\304\002\207w\244(u\302\034\237\244\376=\347\272\2065\314\365\270\253\233\003\336\220\242\026\304]\257\0056\032j\022\356TE\234\340V\343s,\251\351>}\241\230\224\252\231)e2\352(\024NY\250H\347\371\377\311\264\354\367Z h\030\255\f\266\345r\246\303\000\362\312\'\236\354[\2576\247\222 \232\257\350\324\235\2719\360\\\033\2732\201UL\251\253\2031#\325\325\355\355\325\251\347\354\267\023\254\2564\233p\212]\273\236\331\300+\326l\336\374[\\&u:\200P\271\r\341X\232\255\035(\376oZ.>\265\226\260\231Dh\326\314\207\333\2306\225\260\306c\232\214\213c\265}\273\345\351B\311\241{\347$\237IB\267\261\252\375\225\216\034\\\370y7\335\341\223{\230p\002\\\227\232\355\214v{\215\273*\342\275\367\357\030\361\026\201\375\312\337H\310\3063\366A\364\022\334\371\b\245\310t\202/\232\316\247C\333;\267(\231\252I\224M\000y\242\362\017}\033kB\302W\a\005zmZq\032\267\\\262\340%\206S\357\266\254\352Lvj\222r\310\2153V\262\314\241b\245\354\330k8\223\2263\312[\374\227\306\345%\223>\344\250.\213\v\024z\237K>\322\223\301\260NQ\230VJ\024\000\306Vq\225\201GNQ\333KDYF5\371F,8\252\336\033\321V;\323\223\250 \351f\r\205\251\270:\257\324\342\373\017^\204?9k\246Tm\346\210\267\313\335x\326@t\266\335\032\\\352\017\275\022U>{r\003\207#\330\361ey\004\252\266f\304\210=$\204\352\216\325E\023+>\373\355\034\267\303\002\2608m1\361\200\226\235\000\204\021L\245\r_#\305\314\255\273\324\257\276\305\030\373\221\243\211\252J\334X\3433\t\361\211\301\243D\037\211\254)Q\230u\226\362\242tz\322\351\320\274q\306e%\362\276\005\324\255\001\336 \207D\f\313\302\265\033u-\002\265g\335\276\253\026\306\267{A\334\027\004h\331\356L\202%\f\025\310\223\035\332\346cj\306\357W\345\016)\351i\360\373\245\2350c\232\272\a\332\377\217 K\210\343\212\200\253\035\250\357\327\n\300\230\222\335\342\031\256\336#\256"
