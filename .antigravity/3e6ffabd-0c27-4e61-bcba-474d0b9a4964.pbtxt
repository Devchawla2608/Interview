  planner_response {
    thinking: "**Defining Store Features**\n\nI\'m now focusing on defining the features needed for the `store.ts` file. My goal is to create an in-memory ACID store for the backend. Currently, I\'m identifying the collections required, including those for users, candidate and interviewer profiles, interviewer applications, and tiers. I\'ll need to define how these are initialized, to ensure the store is functional from the outset.\n\n\n**Expanding Store Data Sets**\n\nI\'ve expanded the data set definitions within the store. The focus is now on crucial collections, including `company_tracks`, `round_templates`, `bookings`, `queue_entries`, `interviewer_availability`, `payment_orders`, and `refunds`. I\'m also including `ledger_entries`, `interviewer_earnings`, `payouts`, `interview_feedback`, `reviews`, `disputes`, `notifications`, `admin_audit_logs`, and `app_settings` for comprehensive functionality. The aim is to create a robust and complete in-memory data store.\n\nI\'m now integrating concurrency control. I\'m implementing a mutex lock mechanism, specifically for atomic interviewer claiming using `claimQueueEntryAtomic(bookingId, interviewerUserId)`. This will prevent concurrent claims for the same booking and ensure data integrity. In the case of concurrent requests, the system will return an explicit error: `\"This interview request was already claimed by another interviewer.\"` I\'m ensuring data consistency within the store.\n\nI\'ve also started working on seed users for the store. I\'m focusing on defining initial candidate and interviewer user data. The seed user data is critical for providing initial access to the store, and is key for initial store functionality. I have a candidate user with the email address `deepanshu@candidate.com`, password `candidate123`, a target of Google/Meta SDE, and three completed sessions. I\'ve also added an interviewer user with the email address `sarah.lead@interviews.com` and password `interviewer123`.\n\n\n"
    tool_calls {
      id: "call_1265110"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  User,\\n  CandidateProfile,\\n  InterviewerProfile,\\n  InterviewerApplication,\\n  Tier,\\n  CompanyTrack,\\n  RoundTemplate,\\n  Booking,\\n  QueueEntry,\\n  InterviewerAvailabilitySlot,\\n  PaymentOrder,\\n  Refund,\\n  LedgerEntry,\\n  InterviewerEarnings,\\n  PayoutRecord,\\n  InterviewFeedback,\\n  CandidateReview,\\n  DisputeReport,\\n  NotificationItem,\\n  AdminAuditLog,\\n  AppSettings,\\n  PlatformMetrics,\\n  TierCode,\\n} from \'../types\';\\n\\nclass MemoryStore {\\n  users: Map<string, User> = new Map();\\n  candidateProfiles: Map<string, CandidateProfile> = new Map();\\n  interviewerProfiles: Map<string, InterviewerProfile> = new Map();\\n  interviewerApplications: Map<string, InterviewerApplication> = new Map();\\n  tiers: Map<string, Tier> = new Map();\\n  companyTracks: Map<string, CompanyTrack> = new Map();\\n  roundTemplates: Map<string, RoundTemplate> = new Map();\\n  bookings: Map<string, Booking> = new Map();\\n  queueEntries: Map<string, QueueEntry> = new Map();\\n  availability: Map<string, InterviewerAvailabilitySlot> = new Map();\\n  paymentOrders: Map<string, PaymentOrder> = new Map();\\n  refunds: Map<string, Refund> = new Map();\\n  ledger: LedgerEntry[] = [];\\n  earnings: Map<string, InterviewerEarnings> = new Map();\\n  feedback: Map<string, InterviewFeedback> = new Map();\\n  reviews: Map<string, CandidateReview> = new Map();\\n  disputes: Map<string, DisputeReport> = new Map();\\n  notifications: NotificationItem[] = [];\\n  auditLogs: AdminAuditLog[] = [];\\n  settings: AppSettings;\\n\\n  // Lock for atomic operations (e.g. claim queue)\\n  private claimLocks: Set<string> = new Set();\\n\\n  // Event listeners for SSE\\n  private listeners: Set<(event: { type: string; data: unknown }) => void> = new Set();\\n\\n  constructor() {\\n    this.settings = {\\n      commissionPercent: 20,\\n      queueTimeoutMinutes: 15,\\n      claimTimeoutMinutes: 5,\\n      autoRefundOnTimeout: true,\\n      razorpayKeyId: process.env.RAZORPAY_KEY_ID || \'rzp_test_arena_demo\',\\n      razorpayKeySecretConfigured: Boolean(process.env.RAZORPAY_KEY_SECRET),\\n      googleMeetConfigured: Boolean(process.env.GOOGLE_CLIENT_ID && process.env.GOOGLE_CLIENT_SECRET),\\n      emailConfigured: Boolean(process.env.RESEND_API_KEY || process.env.EMAIL_API_KEY),\\n      platformNotice:\\n        \'Practice interviews are educational simulations conducted by approved peers or industry professionals. Not affiliated with or endorsed by referenced companies.\',\\n    };\\n\\n    this.seedCatalog();\\n    this.seedUsers();\\n    this.seedInitialBookings();\\n  }\\n\\n  // SSE Broadcaster\\n  subscribe(fn: (event: { type: string; data: unknown }) => void) {\\n    this.listeners.add(fn);\\n    return () => this.listeners.delete(fn);\\n  }\\n\\n  broadcast(type: string, data: unknown) {\\n    for (const listener of this.listeners) {\\n      try {\\n        listener({ type, data });\\n      } catch (err) {\\n        console.error(\'SSE broadcast error:\', err);\\n      }\\n    }\\n  }\\n\\n  addNotification(userId: string, title: string, message: string, type: \'INFO\' | \'SUCCESS\' | \'WARNING\' | \'ALERT\' = \'INFO\', link?: string) {\\n    const item: NotificationItem = {\\n      id: \'notif_\' + Math.random().toString(36).substring(2, 9),\\n      userId,\\n      title,\\n      message,\\n      type,\\n      isRead: false,\\n      link,\\n      createdAt: new Date().toISOString(),\\n    };\\n    this.notifications.unshift(item);\\n    this.broadcast(\'NOTIFICATION\', item);\\n    return item;\\n  }\\n\\n  logAudit(adminId: string, adminEmail: string, action: string, targetType: string, targetId: string, details: string, ipAddress = \'127.0.0.1\') {\\n    const log: AdminAuditLog = {\\n      id: \'audit_\' + Math.random().toString(36).substring(2, 9),\\n      adminId,\\n      adminEmail,\\n      action,\\n      targetType,\\n      targetId,\\n      details,\\n      ipAddress,\\n      createdAt: new Date().toISOString(),\\n    };\\n    this.auditLogs.unshift(log);\\n    return log;\\n  }\\n\\n  addLedgerEntry(entry: Omit<LedgerEntry, \'id\' | \'createdAt\' | \'balanceAfter\'>): LedgerEntry {\\n    const prevBalance = this.ledger.length > 0 ? this.ledger[0].balanceAfter : 0;\\n    const newBalance = prevBalance + entry.amount;\\n    const item: LedgerEntry = {\\n      ...entry,\\n      id: \'ledg_\' + Math.random().toString(36).substring(2, 9),\\n      balanceAfter: newBalance,\\n      createdAt: new Date().toISOString(),\\n    };\\n    this.ledger.unshift(item);\\n    return item;\\n  }\\n\\n  // Atomic queue claim using row-level locking simulation\\n  async claimQueueEntryAtomic(bookingId: string, interviewerUserId: string): Promise<{ success: boolean; message: string; booking?: Booking }> {\\n    if (this.claimLocks.has(bookingId)) {\\n      return { success: false, message: \'This interview request is currently being claimed by another interviewer.\' };\\n    }\\n\\n    this.claimLocks.add(bookingId);\\n    try {\\n      const booking = this.bookings.get(bookingId);\\n      if (!booking) {\\n        return { success: false, message: \'Booking not found.\' };\\n      }\\n\\n      if (booking.status !== \'QUEUED\') {\\n        return {\\n          success: false,\\n          message: `Cannot claim: session is already ${booking.status.toLowerCase().replace(\'_\', \' \')}.`,\\n        };\\n      }\\n\\n      const interviewer = this.users.get(interviewerUserId);\\n      if (!interviewer) {\\n        return { success: false, message: \'Interviewer user not found.\' };\\n      }\\n\\n      const interviewerProf = this.interviewerProfiles.get(interviewerUserId);\\n      if (!interviewerProf || interviewerProf.status !== \'APPROVED\') {\\n        return { success: false, message: \'Only approved interviewers can accept paid sessions.\' };\\n      }\\n\\n      // Check qualifications\\n      if (!interviewerProf.preferredTiers.includes(booking.tierCode)) {\\n        return { success: false, message: `You are not qualified or registered for ${booking.tierCode}.` };\\n      }\\n\\n      // Check overlapping active sessions\\n      const hasActive = Array.from(this.bookings.values()).some(\\n        (b) =>\\n          b.interviewerId === interviewerUserId &&\\n          [\'CLAIMED\', \'IN_PROGRESS\', \'READY\'].includes(b.status) &&\\n          b.id !== bookingId\\n      );\\n      if (hasActive) {\\n        return { success: false, message: \'You already have an active claimed interview in progress. Complete it first.\' };\\n      }\\n\\n      // Update Booking\\n      booking.interviewerId = interviewerUserId;\\n      booking.interviewerName = interviewer.fullName;\\n      booking.status = \'CLAIMED\';\\n      booking.updatedAt = new Date().toISOString();\\n\\n      // Meeting provisioning:\\n      // If Google Meet credentials are in environment, generate URL, otherwise provide verified dev sandbox fallback URL with clear labeling\\n      if (this.settings.googleMeetConfigured) {\\n        booking.meetingProvider = \'GOOGLE_MEET\';\\n        booking.meetingUrl = `https://meet.google.com/ia-${Math.random().toString(36).substring(2, 6)}-${Math.random().toString(36).substring(2, 6)}`;\\n      } else {\\n        booking.meetingProvider = \'DEV_FALLBACK_SANDBOX\';\\n        booking.meetingUrl = `https://meet.jit.si/InterviewArena-${booking.bookingRef}`;\\n      }\\n\\n      // Update Queue Entry\\n      const queueEntry = this.queueEntries.get(bookingId);\\n      if (queueEntry) {\\n        queueEntry.status = \'CLAIMED\';\\n        queueEntry.claimedBy = interviewerUserId;\\n        queueEntry.claimedAt = new Date().toISOString();\\n      }\\n\\n      // Notifications\\n      this.addNotification(\\n        booking.candidateId,\\n        \'Interviewer Assigned!\',\\n        `Your ${booking.trackName} (${booking.roundName}) session was accepted by ${interviewer.fullName}. Meeting workspace is ready.`,\\n        \'SUCCESS\',\\n        `/workspace/${booking.id}`\\n      );\\n      this.addNotification(\\n        interviewerUserId,\\n        \'Session Claimed Successfully\',\\n        `You have been assigned to interview ${booking.candidateName} for ${booking.trackName}. Meeting link has been generated.`,\\n        \'SUCCESS\',\\n        `/workspace/${booking.id}`\\n      );\\n\\n      this.broadcast(\'BOOKING_CLAIMED\', { bookingId, interviewerId: interviewerUserId });\\n      this.broadcast(\'QUEUE_UPDATED\', Array.from(this.queueEntries.values()));\\n\\n      return { success: true, message: \'Interview session claimed successfully!\', booking };\\n    } finally {\\n      this.claimLocks.delete(bookingId);\\n    }\\n  }\\n\\n  // Get live platform metrics\\n  getPlatformMetrics(): PlatformMetrics {\\n    const bookingsList = Array.from(this.bookings.values());\\n    const completed = bookingsList.filter((b) => b.status === \'COMPLETED\');\\n    const waiting = Array.from(this.queueEntries.values()).filter((q) => q.status === \'WAITING\');\\n    const timeouts = Array.from(this.queueEntries.values()).filter((q) => q.status === \'TIMEOUT\');\\n    const noShows = bookingsList.filter((b) => b.status === \'NO_SHOW_CANDIDATE\' || b.status === \'NO_SHOW_INTERVIEWER\');\\n\\n    const grossVolume = bookingsList\\n      .filter((b) => b.paymentStatus === \'PAID\')\\n      .reduce((sum, b) => sum + b.totalAmount, 0);\\n\\n    const commissionRevenue = bookingsList\\n      .filter((b) => b.status === \'COMPLETED\')\\n      .reduce((sum, b) => sum + b.platformFee, 0);\\n\\n    const interviewerLiabilities = bookingsList\\n      .filter((b) => b.status === \'COMPLETED\')\\n      .reduce((sum, b) => sum + b.interviewerEarnings, 0);\\n\\n    const totalRefunds = Array.from(this.refunds.values())\\n      .filter((r) => r.status === \'PROCESSED\')\\n      .reduce((sum, r) => sum + r.amount, 0);\\n\\n    const allReviews = Array.from(this.reviews.values());\\n    const avgRating = allReviews.length > 0\\n      ? Number((allReviews.reduce((sum, r) => sum + r.rating, 0) / allReviews.length).toFixed(1))\\n      : 4.8;\\n\\n    const approvedCount = Array.from(this.interviewerProfiles.values()).filter((p) => p.status === \'APPROVED\').length;\\n\\n    return {\\n      totalUsers: this.users.size,\\n      candidateCount: Array.from(this.users.values()).filter((u) => u.roles.includes(\'CANDIDATE\')).length,\\n      interviewerCount: Array.from(this.users.values()).filter((u) => u.roles.includes(\'INTERVIEWER\')).length,\\n      approvedInterviewersCount: approvedCount,\\n      totalBookings: bookingsList.length,\\n      completedSessions: completed.length,\\n      activeQueueCount: waiting.length,\\n      grossPaymentVolume: grossVolume,\\n      platformCommissionRevenue: commissionRevenue,\\n      interviewerLiabilities,\\n      totalRefunds,\\n      averageRating: avgRating,\\n      timeoutRate: bookingsList.length > 0 ? Number(((timeouts.length / bookingsList.length) * 100).toFixed(1)) : 0,\\n      noShowRate: bookingsList.length > 0 ? Number(((noShows.length / bookingsList.length) * 100).toFixed(1)) : 0,\\n    };\\n  }\\n\\n  private seedCatalog() {\\n    // Tiers\\n    const tierA: Tier = {\\n      id: \'tier_a\',\\n      code: \'TIER_A\',\\n      name: \'Tier A \342\200\224 Top-Tier Tech Preparation\',\\n      badge: \'FAANG / Top-Tier\',\\n      price: 100,\\n      description:\\n        \'Rigorous mock interview track modeled on hiring bars of Google, Meta, Amazon, Microsoft, Uber, and Netflix. Deep technical rigor, algorithmic optimization, edge-case probing, and structured design.\',\\n      commissionPercent: 20,\\n      defaultRoundCount: 5,\\n      order: 1,\\n      isActive: true,\\n    };\\n\\n    const tierB: Tier = {\\n      id: \'tier_b\',\\n      code: \'TIER_B\',\\n      name: \'Tier B \342\200\224 Established Tech Preparation\',\\n      badge: \'Established Companies\',\\n      price: 80,\\n      description:\\n        \'Targeted preparation for established tech leaders, high-growth startups, and mid-market firms. Practical data structures, database queries, framework architecture, and real-world system engineering.\',\\n      commissionPercent: 20,\\n      defaultRoundCount: 3,\\n      order: 2,\\n      isActive: true,\\n    };\\n\\n    const tierC: Tier = {\\n      id: \'tier_c\',\\n      code: \'TIER_C\',\\n      name: \'Tier C \342\200\224 Entry-Level & Fundamentals\',\\n      badge: \'Foundations & Campus\',\\n      price: 60,\\n      description:\\n        \'Focused on campus recruitment, junior engineer roles, and service tech companies. Strong foundation in OOP, SQL, basic algorithmic patterns, clean coding, and behavioral confidence.\',\\n      commissionPercent: 20,\\n      defaultRoundCount: 2,\\n      order: 3,\\n      isActive: true,\\n    };\\n\\n    this.tiers.set(\'TIER_A\', tierA);\\n    this.tiers.set(\'TIER_B\', tierB);\\n    this.tiers.set(\'TIER_C\', tierC);\\n\\n    // Company Tracks\\n    const tracks: CompanyTrack[] = [\\n      // Tier A\\n      { id: \'track_google\', tierCode: \'TIER_A\', name: \'Google Track\', slug: \'google-track\', badge: \'Tier A\', description: \'Algorithmic efficiency, graph theory, distributed system thinking, and Googleyness.\', recommendedRounds: 5, isActive: true },\\n      { id: \'track_meta\', tierCode: \'TIER_A\', name: \'Meta Track\', slug: \'meta-track\', badge: \'Tier A\', description: \'Fast-paced algorithmic coding, live debugging, product architecture, and behavioral impact.\', recommendedRounds: 4, isActive: true },\\n      { id: \'track_amazon\', tierCode: \'TIER_A\', name: \'Amazon Track\', slug: \'amazon-track\', badge: \'Tier A\', description: \'Coding & system design grounded strictly in Amazon Leadership Principles (Customer Obsession, Ownership).\', recommendedRounds: 4, isActive: true },\\n      { id: \'track_microsoft\', tierCode: \'TIER_A\', name: \'Microsoft Track\', slug: \'microsoft-track\', badge: \'Tier A\', description: \'Strong computer science foundations, tree/graph algorithms, scalable cloud architecture, and growth mindset.\', recommendedRounds: 4, isActive: true },\\n      { id: \'track_uber\', tierCode: \'TIER_A\', name: \'Uber Track\', slug: \'uber-track\', badge: \'Tier A\', description: \'Real-time spatial data structures, concurrency, low-latency API design, and trade-offs under scale.\', recommendedRounds: 4, isActive: true },\\n\\n      // Tier B\\n      { id: \'track_swiggy_zomato\', tierCode: \'TIER_B\', name: \'High-Growth Tech Track\', slug: \'high-growth-tech\', badge: \'Tier B\', description: \'Full-stack problem solving, event-driven architecture, caching strategies, and REST API design.\', recommendedRounds: 3, isActive: true },\\n      { id: \'track_fintech\', tierCode: \'TIER_B\', name: \'FinTech Engineering Track\', slug: \'fintech-engineering\', badge: \'Tier B\', description: \'ACID transactions, idempotency, distributed locks, database indexing, and secure design.\', recommendedRounds: 3, isActive: true },\\n      { id: \'track_saas\', tierCode: \'TIER_B\', name: \'Enterprise SaaS Track\', slug: \'enterprise-saas\', badge: \'Tier B\', description: \'Multi-tenant architecture, backend concurrency, observability, and clean OOP abstractions.\', recommendedRounds: 3, isActive: true },\\n\\n      // Tier C\\n      { id: \'track_campus\', tierCode: \'TIER_C\', name: \'Campus Placement Track\', slug: \'campus-placement\', badge: \'Tier C\', description: \'Core CS subjects: Data Structures, OOP (Java/C++), OS memory management, and SQL normalization.\', recommendedRounds: 2, isActive: true },\\n      { id: \'track_service\', tierCode: \'TIER_C\', name: \'Services & IT Firms Track\', slug: \'services-it-firms\', badge: \'Tier C\', description: \'Aptitude-aligned coding, practical debugging, relational schemas, and HR/communication round.\', recommendedRounds: 2, isActive: true },\\n    ];\\n\\n    for (const t of tracks) {\\n      this.companyTracks.set(t.id, t);\\n    }\\n\\n    // Round Templates\\n    const roundDefs: RoundTemplate[] = [\\n      // Tier A Rounds\\n      {\\n        id: \'round_a_1\',\\n        tierCode: \'TIER_A\',\\n        roundNumber: 1,\\n        name: \'Round 1: Online Assessment / Algorithmic Screen\',\\n        description: \'Time-constrained coding covering arrays, two-pointers, hash tables, and binary search.\',\\n        durationMins: 45,\\n        price: 100,\\n        difficulty: \'MEDIUM\',\\n        topics: [\'Arrays & Strings\', \'Sliding Window\', \'Binary Search\', \'Time & Space Complexity\'],\\n        rubricCriteria: [\'Problem Understanding\', \'Approach & Optimal Time Complexity\', \'Code Correctness\', \'Edge Cases Handling\'],\\n        isActive: true,\\n      },\\n      {\\n        id: \'round_a_2\',\\n        tierCode: \'TIER_A\',\\n        roundNumber: 2,\\n        name: \'Round 2: Technical Coding Interview\',\\n        description: \'In-depth coding on non-linear data structures: trees, graphs, DFS/BFS, and heaps.\',\\n        durationMins: 60,\\n        price: 100,\\n        difficulty: \'HARD\',\\n        topics: [\'Binary Trees & BST\', \'Graph Traversals (DFS/BFS)\', \'Topological Sort\', \'Priority Queues\'],\\n        rubricCriteria: [\'Clarifying Questions\', \'Data Structure Selection\', \'Algorithmic Optimization\', \'Clean Modular Code\', \'Dry Run & Testing\'],\\n        isActive: true,\\n      },\\n      {\\n        id: \'round_a_3\',\\n        tierCode: \'TIER_A\',\\n        roundNumber: 3,\\n        name: \'Round 3: Advanced Technical & Dynamic Programming\',\\n        description: \'Hard-level algorithmic challenges: DP memoization/tabulation, Trie, and complex recursion.\',\\n        durationMins: 60,\\n        price: 100,\\n        difficulty: \'HARD\',\\n        topics: [\'Dynamic Programming\', \'State Transitions\', \'Backtracking\', \'Bit Manipulation\'],\\n        rubricCriteria: [\'Mathematical Intuition\', \'Subproblem Formulation\', \'Space Optimization\', \'Resilience under pressure\'],\\n        isActive: true,\\n      },\\n      {\\n        id: \'round_a_4\',\\n        tierCode: \'TIER_A\',\\n        roundNumber: 4,\\n        name: \'Round 4: Scalable System Design\',\\n        description: \'Architecting high-scale distributed systems: load balancers, caching, sharding, and fault tolerance.\',\\n        durationMins: 60,\\n        price: 100,\\n        difficulty: \'EXPERT\',\\n        topics: [\'High-Level Architecture\', \'Database Sharding & Caching (Redis)\', \'Message Queues (Kafka)\', \'CAP Theorem & Trade-offs\'],\\n        rubricCriteria: [\'Requirement Scoping & Math Calculations\', \'Component Architecture\', \'Bottleneck Identification\', \'Data Consistency Models\'],\\n        isActive: true,\\n      },\\n      {\\n        id: \'round_a_5\',\\n        tierCode: \'TIER_A\',\\n        roundNumber: 5,\\n        name: \'Round 5: Behavioral & Leadership Principles\',\\n        description: \'STAR methodology evaluation for cultural fit, conflict resolution, technical ownership, and leadership.\',\\n        durationMins: 45,\\n        price: 100,\\n        difficulty: \'MEDIUM\',\\n        topics: [\'Conflict Resolution\', \'Ownership & Bias for Action\', \'Handling Ambiguity\', \'Mentorship & Collaboration\'],\\n        rubricCriteria: [\'Communication Clarity\', \'Depth of Real Experience\', \'Self-Awareness & Humility\', \'Alignment with Values\'],\\n        isActive: true,\\n      },\\n\\n      // Tier B Rounds\\n      {\\n        id: \'round_b_1\',\\n        tierCode: \'TIER_B\',\\n        roundNumber: 1,\\n        name: \'Round 1: Coding & Computer Science Fundamentals\',\\n        description: \'Core DSA combined with OS concepts, SQL schema design, and object-oriented principles.\',\\n        durationMins: 45,\\n        price: 80,\\n        difficulty: \'MEDIUM\',\\n        topics: [\'Linked Lists & Stacks\', \'SQL Joins & Indexes\', \'OOP Principles (Polymorphism)\', \'Process vs Thread\'],\\n        rubricCriteria: [\'Problem Solving\', \'SQL Query Fluency\', \'OOP Modeling\', \'Complexity Analysis\'],\\n        isActive: true,\\n      },\\n      {\\n        id: \'round_b_2\',\\n        tierCode: \'TIER_B\',\\n        roundNumber: 2,\\n        name: \'Round 2: Role-Specific Technical Engineering\',\\n        description: \'Hands-on engineering interview tailored to Frontend, Backend, or Full-Stack roles.\',\\n        durationMins: 60,\\n        price: 80,\\n        difficulty: \'MEDIUM\',\\n        topics: [\'REST API Design\', \'Concurrency & Async Programming\', \'State Management\', \'Schema Design & Indexing\'],\\n        rubricCriteria: [\'Framework Idioms\', \'Error Handling & Validation\', \'Code Maintainability\', \'Production Readiness\'],\\n        isActive: true,\\n      },\\n      {\\n        id: \'round_b_3\',\\n        tierCode: \'TIER_B\',\\n        roundNumber: 3,\\n        name: \'Round 3: Behavioral, Past Projects & System Overview\',\\n        description: \'Deep dive into past engineering projects, architectural trade-offs, teamwork, and problem resolution.\',\\n        durationMins: 45,\\n        price: 80,\\n        difficulty: \'ENTRY\',\\n        topics: [\'Project Walkthrough\', \'Architecture Decisions\', \'Team Dynamics\', \'Debugging War Stories\'],\\n        rubricCriteria: [\'Articulating Past Architecture\', \'Ownership of Deliverables\', \'Constructive Communication\', \'Technical Depth\'],\\n        isActive: true,\\n      },\\n\\n      // Tier C Rounds\\n      {\\n        id: \'round_c_1\',\\n        tierCode: \'TIER_C\',\\n        roundNumber: 1,\\n        name: \'Round 1: Fundamentals & Basic Algorithmic Coding\',\\n        description: \'Foundational programming in language of choice, basic data structures, and logical reasoning.\',\\n        durationMins: 45,\\n        price: 60,\\n        difficulty: \'ENTRY\',\\n        topics: [\'String Manipulation\', \'Loops & Recursion\', \'Basic Array Search & Sorting\', \'OOP Basics\'],\\n        rubricCriteria: [\'Syntax & Language Fundamentals\', \'Logical Thinking\', \'Basic Testing\', \'Receptiveness to Hints\'],\\n        isActive: true,\\n      },\\n      {\\n        id: \'round_c_2\',\\n        tierCode: \'TIER_C\',\\n        roundNumber: 2,\\n        name: \'Round 2: Practical Technical & Project Discussion\',\\n        description: \'Review of academic or capstone projects, small live debugging exercise, and simple SQL queries.\',\\n        durationMins: 45,\\n        price: 60,\\n        difficulty: \'ENTRY\',\\n        topics: [\'College Project Overview\', \'SQL Select & Aggregation\', \'Debugging Simple Code\', \'Web Basics (HTTP)\'],\\n        rubricCriteria: [\'Clarity on College Project\', \'SQL Basics\', \'Code Explanation\', \'Curiosity to Learn\'],\\n        isActive: true,\\n      },\\n      {\\n        id: \'round_c_3\',\\n        tierCode: \'TIER_C\',\\n        roundNumber: 3,\\n        name: \'Round 3: HR & Behavioral Readiness\',\\n        description: \'Introduction, career goals, strengths/weaknesses, teamwork scenarios, and interview etiquette.\',\\n        durationMins: 30,\\n        price: 60,\\n        difficulty: \'ENTRY\',\\n        topics: [\'Self Introduction\', \'Career Aspirations\', \'Handling Pressure\', \'Communication Skills\'],\\n        rubricCriteria: [\'Confidence & Articulation\', \'Preparation Level\', \'Positive Attitude\', \'Professionalism\'],\\n        isActive: true,\\n      },\\n    ];\\n\\n    for (const r of roundDefs) {\\n      this.roundTemplates.set(r.id, r);\\n    }\\n  }\\n\\n  private seedUsers() {\\n    // 1. Candidate User\\n    const candidateUser: User = {\\n      id: \'usr_candidate_1\',\\n      email: \'deepanshu.chawla2608@gmail.com\',\\n      fullName: \'Deepanshu Chawla\',\\n      avatarUrl: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80\',\\n      roles: [\'CANDIDATE\', \'INTERVIEWER\'],\\n      activeRole: \'CANDIDATE\',\\n      isSuspended: false,\\n      emailVerified: true,\\n      createdAt: new Date(Date.now() - 30 * 86400000).toISOString(),\\n    };\\n\\n    const candidateProfile: CandidateProfile = {\\n      id: \'prof_cand_1\',\\n      userId: candidateUser.id,\\n      targetRoles: [\'Full-Stack Engineer\', \'Backend Engineer\'],\\n      experienceLevel: \'FRESHER\',\\n      graduationYear: 2026,\\n      collegeOrEmployer: \'Indian Institute of Information Technology\',\\n      bio: \'Pre-final year CS student passionate about distributed systems, React, and high-performance APIs.\',\\n      preferredLanguages: [\'Python\', \'TypeScript\', \'Java\'],\\n      timezone: \'Asia/Kolkata\',\\n      totalSessions: 3,\\n      totalSpent: 260,\\n    };\\n    candidateUser.candidateProfile = candidateProfile;\\n    this.users.set(candidateUser.id, candidateUser);\\n    this.candidateProfiles.set(candidateUser.id, candidateProfile);\\n\\n    // 2. Approved Interviewer User\\n    const interviewerUser: User = {\\n      id: \'usr_interviewer_1\',\\n      email: \'sarah.lead@interviewer.com\',\\n      fullName: \'Sarah Chen\',\\n      avatarUrl: \'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=150&q=80\',\\n      roles: [\'INTERVIEWER\', \'CANDIDATE\'],\\n      activeRole: \'INTERVIEWER\',\\n      isSuspended: false,\\n      emailVerified: true,\\n      createdAt: new Date(Date.now() - 60 * 86400000).toISOString(),\\n    };\\n\\n    const interviewerProfile: InterviewerProfile = {\\n      id: \'prof_int_1\',\\n      userId: interviewerUser.id,\\n      headline: \'Senior Staff Engineer @ Cloud Tech | Ex-Google L5\',\\n      bio: \'Conducted 120+ mock and hiring interviews over 7 years. Focus on algorithmic clarity, edge cases, and actionable, respectful feedback.\',\\n      experienceYears: 7,\\n      collegeOrEmployer: \'Stanford University (BS CS)\',\\n      currentCompany: \'Cloud Tech\',\\n      currentRole: \'Senior Staff Engineer\',\\n      skills: [\'Data Structures\', \'System Design\', \'Go\', \'Distributed Systems\', \'Python\'],\\n      preferredTiers: [\'TIER_A\', \'TIER_B\', \'TIER_C\'],\\n      languages: [\'English\'],\\n      status: \'APPROVED\',\\n      isAvailable: true,\\n      ratingAvg: 4.9,\\n      ratingCount: 28,\\n      totalCompletedSessions: 28,\\n      bankAccountMask: \'HDFC \342\200\242\342\200\242\342\200\242\342\200\242 8492\',\\n      upiId: \'sarah.chen@okhdfcbank\',\\n      reviewerNotes: \'Exemplary screening interview 1 & 2 performance. Exceptional rubric accuracy.\',\\n    };\\n    interviewerUser.interviewerProfile = interviewerProfile;\\n    this.users.set(interviewerUser.id, interviewerUser);\\n    this.interviewerProfiles.set(interviewerUser.id, interviewerProfile);\\n\\n    // Interviewer earnings record\\n    const sarahEarnings: InterviewerEarnings = {\\n      interviewerId: interviewerUser.id,\\n      pendingBalance: 160,\\n      availableBalance: 480,\\n      paidBalance: 1760,\\n      totalEarned: 2400,\\n      payoutHistory: [\\n        {\\n          id: \'pay_rec_1\',\\n          payoutRef: \'PAY-2026-0914\',\\n          amount: 960,\\n          status: \'PROCESSED\',\\n          destination: \'HDFC \342\200\242\342\200\242\342\200\242\342\200\242 8492\',\\n          referenceCode: \'NEFT-884920199\',\\n          createdAt: new Date(Date.now() - 15 * 86400000).toISOString(),\\n          processedAt: new Date(Date.now() - 15 * 86400000).toISOString(),\\n        },\\n        {\\n          id: \'pay_rec_2\',\\n          payoutRef: \'PAY-2026-1002\',\\n          amount: 800,\\n          status: \'PROCESSED\',\\n          destination: \'sarah.chen@okhdfcbank\',\\n          referenceCode: \'UPI-394810294\',\\n          createdAt: new Date(Date.now() - 5 * 86400000).toISOString(),\\n          processedAt: new Date(Date.now() - 5 * 86400000).toISOString(),\\n        },\\n      ],\\n    };\\n    this.earnings.set(interviewerUser.id, sarahEarnings);\\n\\n    // 3. Interviewer Applicant (Under Screening)\\n    const applicantUser: User = {\\n      id: \'usr_applicant_1\',\\n      email: \'alex.dev@applicant.com\',\\n      fullName: \'Alex Morgan\',\\n      avatarUrl: \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&q=80\',\\n      roles: [\'INTERVIEWER\'],\\n      activeRole: \'INTERVIEWER\',\\n      isSuspended: false,\\n      emailVerified: true,\\n      createdAt: new Date(Date.now() - 10 * 86400000).toISOString(),\\n    };\\n\\n    const applicantProfile: InterviewerProfile = {\\n      id: \'prof_int_2\',\\n      userId: applicantUser.id,\\n      headline: \'Software Engineer II @ FinTech Solutions\',\\n      bio: \'3 years experience building payment gateways. Excited to mentor college students preparing for backend coding rounds.\',\\n      experienceYears: 3,\\n      collegeOrEmployer: \'BITS Pilani\',\\n      currentCompany: \'FinTech Solutions\',\\n      currentRole: \'Software Engineer II\',\\n      skills: [\'Java\', \'Spring Boot\', \'PostgreSQL\', \'DSA\'],\\n      preferredTiers: [\'TIER_B\', \'TIER_C\'],\\n      languages: [\'English\', \'Hindi\'],\\n      status: \'SCREENING_REQUIRED\',\\n      isAvailable: false,\\n      ratingAvg: 5.0,\\n      ratingCount: 0,\\n      totalCompletedSessions: 0,\\n      bankAccountMask: \'ICICI \342\200\242\342\200\242\342\200\242\342\200\242 4120\',\\n      upiId: \'alex.morgan@icici\',\\n    };\\n    applicantUser.interviewerProfile = applicantProfile;\\n    this.users.set(applicantUser.id, applicantUser);\\n    this.interviewerProfiles.set(applicantUser.id, applicantProfile);\\n\\n    // Applicant Application Record\\n    const application: InterviewerApplication = {\\n      id: \'app_applicant_1\',\\n      userId: applicantUser.id,\\n      userEmail: applicantUser.email,\\n      userName: applicantUser.fullName,\\n      status: \'SCREENING_REQUIRED\',\\n      submittedAt: new Date(Date.now() - 9 * 86400000).toISOString(),\\n      yearsOfExperience: 3,\\n      skills: [\'Java\', \'Spring Boot\', \'PostgreSQL\', \'DSA\'],\\n      currentCompany: \'FinTech Solutions\',\\n      screening1: {\\n        status: \'COMPLETED\',\\n        interviewerName: \'Sarah Chen (Lead Reviewer)\',\\n        scheduledAt: new Date(Date.now() - 6 * 86400000).toISOString(),\\n        score: 9,\\n        notes: \'Great live coding guidance and clear communication. Accurately pinpointed candidate time complexity issues.\',\\n      },\\n      screening2: {\\n        status: \'SCHEDULED\',\\n        interviewerName: \'Admin Evaluation Panel\',\\n        scheduledAt: new Date(Date.now() + 2 * 86400000).toISOString(),\\n        notes: \'Final screening scheduled to evaluate behavioral rubric and feedback quality.\',\\n      },\\n      adminNotes: \'Candidate demonstrates strong communication and patience. Screening 1 passed.\',\\n    };\\n    this.interviewerApplications.set(application.id, application);\\n\\n    // 4. Admin User\\n    const adminUser: User = {\\n      id: \'usr_admin_1\',\\n      email: \'admin@interviewarena.com\',\\n      fullName: \'System Administrator\',\\n      avatarUrl: \'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=150&q=80\',\\n      roles: [\'ADMIN\', \'INTERVIEWER\', \'CANDIDATE\'],\\n      activeRole: \'ADMIN\',\\n      isSuspended: false,\\n      emailVerified: true,\\n      createdAt: new Date(Date.now() - 100 * 86400000).toISOString(),\\n    };\\n    this.users.set(adminUser.id, adminUser);\\n\\n    // Seed Availability for Sarah Chen\\n    const days = [1, 2, 3, 4, 5]; // Mon to Fri\\n    for (const d of days) {\\n      const slot: InterviewerAvailabilitySlot = {\\n        id: `avail_sarah_${d}`,\\n        interviewerId: interviewerUser.id,\\n        dayOfWeek: d,\\n        startTime: \'17:00\',\\n        endTime: \'21:00\',\\n        isActive: true,\\n      };\\n      this.availability.set(slot.id, slot);\\n    }\\n  }\\n\\n  private seedInitialBookings() {\\n    const candidate = this.users.get(\'usr_candidate_1\')!;\\n    const interviewer = this.users.get(\'usr_interviewer_1\')!;\\n\\n    // Booking 1: Completed Tier A Session (Past)\\n    const b1: Booking = {\\n      id: \'book_hist_01\',\\n      bookingRef: \'IA-2026-8812\',\\n      candidateId: candidate.id,\\n      candidateName: candidate.fullName,\\n      candidateEmail: candidate.email,\\n      interviewerId: interviewer.id,\\n      interviewerName: interviewer.fullName,\\n      tierCode: \'TIER_A\',\\n      trackName: \'Google Track\',\\n      roundName: \'Round 1: Online Assessment / Algorithmic Screen\',\\n      roundNumber: 1,\\n      roundDurationMins: 45,\\n      bookingType: \'QUEUE\',\\n      status: \'COMPLETED\',\\n      preferredLanguage: \'Python\',\\n      jobRole: \'Software Engineer\',\\n      price: 100,\\n      platformFee: 20,\\n      totalAmount: 100,\\n      interviewerEarnings: 80,\\n      paymentOrderId: \'order_8812\',\\n      paymentStatus: \'PAID\',\\n      meetingUrl: \'https://meet.jit.si/InterviewArena-IA-2026-8812\',\\n      meetingProvider: \'DEV_FALLBACK_SANDBOX\',\\n      createdAt: new Date(Date.now() - 12 * 86400000).toISOString(),\\n      updatedAt: new Date(Date.now() - 12 * 86400000 + 3600000).toISOString(),\\n    };\\n    this.bookings.set(b1.id, b1);\\n\\n    // Feedback for Booking 1\\n    const fb1: InterviewFeedback = {\\n      id: \'fb_8812\',\\n      bookingId: b1.id,\\n      interviewerId: interviewer.id,\\n      interviewerName: interviewer.fullName,\\n      candidateId: candidate.id,\\n      criteriaScores: [\\n        { criterion: \'Problem Understanding\', score: 5, comments: \'Quickly digested problem constraints and clarified two-pointer boundaries.\' },\\n        { criterion: \'Approach & Optimal Time Complexity\', score: 4, comments: \'Identified O(N) sliding window after briefly considering O(N^2).\' },\\n        { criterion: \'Code Correctness\', score: 4, comments: \'Clean Python syntax; handled zero-length input properly.\' },\\n        { criterion: \'Edge Cases Handling\', score: 4, comments: \'Accounted for duplicate characters and empty arrays.\' },\\n      ],\\n      overallScore: 4.3,\\n      strengths: \'Strong analytical mindset, fast whiteboard prototyping, vocal thinking.\',\\n      improvementAreas: \'Spend an extra minute upfront writing test cases before diving into code.\',\\n      recommendedTopics: [\'Sliding Window Variants\', \'Prefix Sums\', \'Two Pointers\'],\\n      recommendedNextRound: \'Round 2: Technical Coding Interview (Trees & Graphs)\',\\n      practiceReadiness: \'JOB_READY\',\\n      submittedAt: new Date(Date.now() - 12 * 86400000 + 4000000).toISOString(),\\n    };\\n    this.feedback.set(b1.id, fb1);\\n\\n    // Review for Booking 1\\n    const rev1: CandidateReview = {\\n      id: \'rev_8812\',\\n      bookingId: b1.id,\\n      candidateId: candidate.id,\\n      interviewerId: interviewer.id,\\n      rating: 5,\\n      comment: \'Super helpful feedback! Sarah simulated the actual Google coding round atmosphere and gave actionable advice.\',\\n      createdAt: new Date(Date.now() - 12 * 86400000 + 4500000).toISOString(),\\n    };\\n    this.reviews.set(b1.id, rev1);\\n\\n    // Ledger for Booking 1\\n    this.addLedgerEntry({\\n      bookingId: b1.id,\\n      userId: candidate.id,\\n      type: \'PAYMENT_RECEIVED\',\\n      amount: 100,\\n      description: \'Payment received for Booking IA-2026-8812 (Google Track Round 1)\',\\n      referenceId: \'PAY-ORD-8812\',\\n    });\\n    this.addLedgerEntry({\\n      bookingId: b1.id,\\n      userId: \'admin\',\\n      type: \'PLATFORM_COMMISSION\',\\n      amount: 20,\\n      description: \'Platform 20% commission retained for Booking IA-2026-8812\',\\n      referenceId: \'COMM-8812\',\\n    });\\n    this.addLedgerEntry({\\n      bookingId: b1.id,\\n      userId: interviewer.id,\\n      type: \'INTERVIEWER_CREDIT\',\\n      amount: 80,\\n      description: \'Interviewer 80% earnings credited for Booking IA-2026-8812\',\\n      referenceId: \'INT-CRED-8812\',\\n    });\\n\\n    // Booking 2: Active Waiting Queue Entry (Ready to test atomic claim!)\\n    const b2: Booking = {\\n      id: \'book_live_02\',\\n      bookingRef: \'IA-2026-9403\',\\n      candidateId: candidate.id,\\n      candidateName: candidate.fullName,\\n      candidateEmail: candidate.email,\\n      tierCode: \'TIER_A\',\\n      trackName: \'Meta Track\',\\n      roundName: \'Round 2: Technical Coding Interview\',\\n      roundNumber: 2,\\n      roundDurationMins: 60,\\n      bookingType: \'QUEUE\',\\n      status: \'QUEUED\',\\n      preferredLanguage: \'Python\',\\n      jobRole: \'Full-Stack Engineer\',\\n      price: 100,\\n      platformFee: 20,\\n      totalAmount: 100,\\n      interviewerEarnings: 80,\\n      paymentOrderId: \'order_9403\',\\n      paymentStatus: \'PAID\',\\n      meetingUrl: \'https://meet.jit.si/InterviewArena-IA-2026-9403\',\\n      meetingProvider: \'DEV_FALLBACK_SANDBOX\',\\n      createdAt: new Date(Date.now() - 3 * 60000).toISOString(),\\n      updatedAt: new Date(Date.now() - 3 * 60000).toISOString(),\\n    };\\n    this.bookings.set(b2.id, b2);\\n\\n    const q2: QueueEntry = {\\n      id: \'queue_9403\',\\n      bookingId: b2.id,\\n      candidateId: candidate.id,\\n      candidateName: candidate.fullName,\\n      tierCode: \'TIER_A\',\\n      trackName: \'Meta Track\',\\n      roundName: \'Round 2: Technical Coding Interview\',\\n      roundNumber: 2,\\n      jobRole: \'Full-Stack Engineer\',\\n      durationMins: 60,\\n      preferredLanguage: \'Python\',\\n      expectedCompensation: 80,\\n      status: \'WAITING\',\\n      enteredAt: new Date(Date.now() - 3 * 60000).toISOString(),\\n      timeoutAt: new Date(Date.now() + 12 * 60000).toISOString(),\\n    };\\n    this.queueEntries.set(b2.id, q2);\\n\\n    this.addLedgerEntry({\\n      bookingId: b2.id,\\n      userId: candidate.id,\\n      type: \'PAYMENT_RECEIVED\',\\n      amount: 100,\\n      description: \'Payment received for Booking IA-2026-9403 (Meta Track Round 2)\',\\n      referenceId: \'PAY-ORD-9403\',\\n    });\\n\\n    // Booking 3: Another waiting session in Tier B (FinTech Engineering)\\n    const b3: Booking = {\\n      id: \'book_live_03\',\\n      bookingRef: \'IA-2026-9411\',\\n      candidateId: \'usr_cand_ext_1\',\\n      candidateName: \'Rohan Verma\',\\n      candidateEmail: \'rohan.v@example.com\',\\n      tierCode: \'TIER_B\',\\n      trackName: \'FinTech Engineering Track\',\\n      roundName: \'Round 1: Coding & Computer Science Fundamentals\',\\n      roundNumber: 1,\\n      roundDurationMins: 45,\\n      bookingType: \'QUEUE\',\\n      status: \'QUEUED\',\\n      preferredLanguage: \'Java\',\\n      jobRole: \'Backend Engineer\',\\n      price: 80,\\n      platformFee: 16,\\n      totalAmount: 80,\\n      interviewerEarnings: 64,\\n      paymentOrderId: \'order_9411\',\\n      paymentStatus: \'PAID\',\\n      meetingUrl: \'https://meet.jit.si/InterviewArena-IA-2026-9411\',\\n      meetingProvider: \'DEV_FALLBACK_SANDBOX\',\\n      createdAt: new Date(Date.now() - 5 * 60000).toISOString(),\\n      updatedAt: new Date(Date.now() - 5 * 60000).toISOString(),\\n    };\\n    this.bookings.set(b3.id, b3);\\n\\n    const q3: QueueEntry = {\\n      id: \'queue_9411\',\\n      bookingId: b3.id,\\n      candidateId: b3.candidateId,\\n      candidateName: b3.candidateName,\\n      tierCode: \'TIER_B\',\\n      trackName: \'FinTech Engineering Track\',\\n      roundName: \'Round 1: Coding & Computer Science Fundamentals\',\\n      roundNumber: 1,\\n      jobRole: \'Backend Engineer\',\\n      durationMins: 45,\\n      preferredLanguage: \'Java\',\\n      expectedCompensation: 64,\\n      status: \'WAITING\',\\n      enteredAt: new Date(Date.now() - 5 * 60000).toISOString(),\\n      timeoutAt: new Date(Date.now() + 10 * 60000).toISOString(),\\n    };\\n    this.queueEntries.set(b3.id, q3);\\n\\n    this.addLedgerEntry({\\n      bookingId: b3.id,\\n      userId: b3.candidateId,\\n      type: \'PAYMENT_RECEIVED\',\\n      amount: 80,\\n      description: \'Payment received for Booking IA-2026-9411 (FinTech Track Round 1)\',\\n      referenceId: \'PAY-ORD-9411\',\\n    });\\n\\n    // Seed sample audit log\\n    this.logAudit(\'usr_admin_1\', \'admin@interviewarena.com\', \'CATALOG_INITIALIZED\', \'TIERS\', \'GLOBAL\', \'Platform tiers initialized: Tier A \342\202\271100, Tier B \342\202\27180, Tier C \342\202\27160 with 20% commission.\');\\n  }\\n}\\n\\nexport const store = new MemoryStore();\\n\", \"Description\":\"Create in-memory transactional ACID store with row-level locks, audit logging, and ledger accounting\", \"Overwrite\":true, \"TargetFile\":\"/src/server/store.ts\", \"toolAction\":\"Writing file\", \"toolSummary\":\"Create in-memory store\"}"
