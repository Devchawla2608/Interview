    content: "      console.error(\'Failed to load interviewer dashboard data:\', err);\n    }\n  };\n\n  const handleToggleAvailability = async () => {\n    try {\n      const res = await api.toggleAvailability();\n      setIsAvailable(res.isAvailable);\n    } catch (err: any) {\n      alert(err.message || \'Failed to toggle availability\');\n    }\n  };\n\n  const handleClaimSession = async (bookingId: string) => {\n    setClaimingId(bookingId);\n    setClaimError(null);\n    try {\n      const res = await api.claimQueueEntry(bookingId);\n      if (res.success) {\n        onOpenWorkspace(res.booking.id);\n      }\n    } catch (err: any) {\n      setClaimError(err.message || \'This session was already claimed by another interviewer.\');\n      // refresh queue\n      loadData();\n    } finally {\n      setClaimingId(null);\n    }\n  };\n\n  const handleRequestPayout = async (e: React.FormEvent) => {\n    e.preventDefault();\n    const amt = Number(payoutAmount);\n    if (!amt || amt <= 0) return;\n\n    setIsProcessingPayout(true);\n    try {\n      const res = await api.requestPayout(amt, payoutUpi);\n      setEarnings(res.earnings);\n      setShowPayoutModal(false);\n      setPayoutAmount(\'\');\n      alert(`Payout of \342\202\271${amt} processed successfully to ${payoutUpi}`);\n    } catch (err: any) {\n      alert(err.message || \'Payout request failed\');\n    } finally {\n      setIsProcessingPayout(false);"
