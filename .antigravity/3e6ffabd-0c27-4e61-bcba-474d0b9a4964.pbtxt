  view_file {
    absolute_path_uri: "file:///src/components/SessionWorkspace.tsx"
    start_line: 169
    end_line: 259
    content: "        <div className=\"flex items-center space-x-3\">\n          <button\n            onClick={() => setShowDisputeModal(true)}\n            className=\"px-3 py-2 rounded-xl border border-rose-500/30 text-rose-300 hover:bg-rose-500/10 text-xs font-semibold transition flex items-center space-x-1.5\"\n          >\n            <AlertTriangle className=\"w-3.5 h-3.5\" />\n            <span>Report Problem</span>\n          </button>\n\n          {isInterviewer && booking.status !== \'COMPLETED\' && (\n            <button\n              onClick={() => onOpenFeedbackModal(booking.id)}\n              className=\"px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md shadow-indigo-600/30 transition flex items-center space-x-2\"\n            >\n              <Sparkles className=\"w-4 h-4\" />\n              <span>Submit Structured Feedback</span>\n            </button>\n          )}\n\n          {isCandidate && booking.status === \'COMPLETED\' && !review && (\n            <button\n              onClick={() => onOpenReviewModal(booking.id)}\n              className=\"px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold shadow-md transition flex items-center space-x-2\"\n            >\n              <Star className=\"w-4 h-4\" />\n              <span>Rate Interviewer</span>\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Main Grid: Video/Meeting Link + Timer + Scratchpads */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left Column: Meeting room & details */}\n        <div className=\"lg:col-span-7 space-y-6\">\n          {/* Meeting Room Card */}\n          <div className=\"rounded-3xl bg-slate-900 border border-slate-800 p-6 space-y-5 shadow-xl\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center space-x-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-indigo-600/20 text-indigo-400 flex items-center justify-center\">\n                  <Video className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <h3 className=\"text-base font-bold text-white\">Live Meeting Conference</h3>\n                  <p className=\"text-xs text-slate-400\">\n                    Provider:{\' \'}\n                    <span className=\"text-indigo-300 font-medium\">\n                      {booking.meetingProvider === \'GOOGLE_MEET\'\n                        ? \'Google Meet (Calendar API)\'\n                        : \'Dev Video Sandbox (Jitsi)\'}\n                    </span>\n                  </p>\n                </div>\n              </div>\n\n              <span className=\"text-[11px] font-bold px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30\">\n                MEETING READY\n              </span>\n            </div>\n\n            {/* Provider notice */}\n            {booking.meetingProvider === \'DEV_FALLBACK_SANDBOX\' && (\n              <div className=\"p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-[11px] text-slate-400 space-y-1\">\n                <div className=\"text-indigo-400 font-semibold flex items-center space-x-1.5\">\n                  <ShieldAlert className=\"w-3.5 h-3.5\" />\n                  <span>Development Fallback Enabled</span>\n                </div>\n                <p>\n                  Google Calendar OAuth credentials are not configured in `.env`. The platform automatically provisions a real-time web video room so you can immediately conduct the practice interview without interruptions.\n                </p>\n              </div>\n            )}\n\n            <div className=\"p-5 rounded-2xl bg-slate-950 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n              <div>\n                <div className=\"text-xs text-slate-400\">Encrypted Meeting URL:</div>\n                <div className=\"text-sm font-mono text-indigo-300 truncate max-w-sm mt-0.5\">\n                  {booking.meetingUrl}\n                </div>\n              </div>\n\n              <a\n                href={booking.meetingUrl}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs shadow-md shadow-indigo-600/30 transition flex items-center justify-center space-x-2 shrink-0\"\n              >\n                <span>Join Meeting Call</span>\n                <ExternalLink className=\"w-4 h-4\" />\n              </a>\n            </div>"
    num_lines: 495
    num_bytes: 21100
    line_range_bytes: 4508
  }
}
