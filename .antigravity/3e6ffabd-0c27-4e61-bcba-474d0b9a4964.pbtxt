      thinking_signature: "\022\362\v\n\357\v\001i\024}\023)w\336\372\3021D\374\001\350\221\366~\201\202F\276\235\307\242\313\220\357\210\217\"\224\311\206\002\206$\003\213\'/S\314\316ZO\226\222;G6\247?m\377w\207\375&KS0E\v)M\211F\214H\371\026\362\245s\233\261\r`\315\237\344\262!{\033\273u\351\340a3jE\313\020\363\327\376\235M\257i\343\222\210\036\244\262\370BG\316A\\k\371\264\336\350\373t\343m\005x\304\306\311\276\315e\300\372${S\364+\211E\r\030L\241\2449\251W\306\367lh\346\326Fh\250[X\026\312\273\034\233|\227\206:RR\341G\237\017G\306\v\225\375 \322\0267Woa\313\\@\024[\364\345\225\302/O\344+1k9\322U\240lV\310DGqc\222/D^\206\307\231\255\220N\267jFk\034\017zl\273P\3629mD+bEJW\366D\377\336u~}\016\344l\361\213H(\214\257\210M\3262\270\336\241\b\313x_\231*\227\b\\\036\amZ16\223;5\305\306EWD[\210\300\214\310{V\005J\317\303\3555\231\220;#?\216\360c\332\216\037\374\033 $\255\a\231R\306\032&\226\214\a7e\345\253\214v\005\362\236\222\036\357E\270\270/\311\372\252\364(\335G\004\261\0068\226N\326\370G\255\0172\230|\233\"z\333\237ds\235*\2730\334\"\274q\"d\232@\3670>\316\241\347\250\026\262\004,SS@~.99\227\245\266\273\220\350@\f\367\370<\262r^\016>@\253\343\362$\340\267\244\211\272\016\237\365N\350R\262\207\257\2021\263\0063-\313?\204^\t\247\237\314~E\260\320\354rj\255~\221>1G\305\227\214\301\305\210\226\241}\217\251\227\310\260B\034\204\001\033\272n\311\370yr\264\262\031o\000\332\2504\005a+\347\370Q\305\b\372\351\236\276b\354\2430\017GK\314\225\253\262\212\350\256\3623\220\326>\a\325.s4\213iH\205\353JO|8\255\314}\263}\034Y\210\225>\331TJ\373l>{\275\311}4O\204\324\320\005m\247\253\355\204V\320\225\211\354\023\261:\346[\224\327`\300\206\f\244R\316*\237\373\025\365P\225=\256*nT_\307A\213\370\265C0]N\306/\000`z5\205\331#p\212\022\030\205b\0177\247\274*G\227\272z6\000\217[z\301\234F\231\344\254\331Y\261\216X\200\345\317\276\306\023\201\256\252\216(\271\205B\024r4o\366\223\031\230\006\f\271-\036\177\351\377\006\0375\226itm\2643\220\023M\311\315\202\000\201\314\273\374\300\322w\271\bte#