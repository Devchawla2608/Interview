  planner_response {
    thinking: "**Defining Interviewer Endpoints**\n\nI\'m now outlining the API endpoints for interviewer functionality. I\'ve defined `/api/interviewer/apply` for applications, `/api/interviewer/application` for status checks, and `/api/interviewer/toggle-availability`. This will streamline the interviewer application process and availability management.\n\n\n"
    tool_calls {
      id: "call_1602839"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { Router } from \'express\';\\nimport { store } from \'../store\';\\nimport { InterviewerApplication, InterviewerProfile, PayoutRecord } from \'../../types\';\\n\\nexport const interviewerRouter = Router();\\n\\n// Get interviewer profile and application status\\ninterviewerRouter.get(\'/profile\', (req, res) => {\\n  const userId = (req.headers[\'x-user-id\'] as string) || \'usr_interviewer_1\';\\n  const profile = store.interviewerProfiles.get(userId);\\n  const application = Array.from(store.interviewerApplications.values()).find((a) => a.userId === userId);\\n\\n  return res.json({ profile, application });\\n});\\n\\n// Submit interviewer application\\ninterviewerRouter.post(\'/apply\', (req, res) => {\\n  const userId = (req.headers[\'x-user-id\'] as string) || \'usr_candidate_1\';\\n  const user = store.users.get(userId);\\n  if (!user) return res.status(401).json({ error: \'User not found\' });\\n\\n  const {\\n    headline,\\n    bio,\\n    experienceYears,\\n    collegeOrEmployer,\\n    currentCompany,\\n    currentRole,\\n    skills,\\n    preferredTiers,\\n    languages,\\n    upiId,\\n    bankAccountMask,\\n  } = req.body;\\n\\n  // Create / Update Interviewer Profile\\n  const profile: InterviewerProfile = {\\n    id: \'prof_\' + userId,\\n    userId,\\n    headline: headline || \'Software Engineer\',\\n    bio: bio || \'\',\\n    experienceYears: Number(experienceYears) || 2,\\n    collegeOrEmployer: collegeOrEmployer || \'\',\\n    currentCompany: currentCompany || \'\',\\n    currentRole: currentRole || \'\',\\n    skills: skills || [\'Data Structures\', \'System Design\'],\\n    preferredTiers: preferredTiers || [\'TIER_A\', \'TIER_B\'],\\n    languages: languages || [\'English\'],\\n    status: \'SCREENING_REQUIRED\',\\n    isAvailable: false,\\n    ratingAvg: 5.0,\\n    ratingCount: 0,\\n    totalCompletedSessions: 0,\\n    bankAccountMask: bankAccountMask || \'\',\\n    upiId: upiId || \'\',\\n  };\\n  store.interviewerProfiles.set(userId, profile);\\n\\n  if (!user.roles.includes(\'INTERVIEWER\')) {\\n    user.roles.push(\'INTERVIEWER\');\\n  }\\n\\n  // Create Interviewer Application\\n  const application: InterviewerApplication = {\\n    id: \'app_\' + Math.random().toString(36).substring(2, 9),\\n    userId,\\n    userEmail: user.email,\\n    userName: user.fullName,\\n    status: \'SCREENING_REQUIRED\',\\n    submittedAt: new Date().toISOString(),\\n    yearsOfExperience: Number(experienceYears) || 2,\\n    skills: skills || [],\\n    currentCompany: currentCompany || \'\',\\n    screening1: {\\n      status: \'PENDING\',\\n      notes: \'Initial technical mock evaluation to assess live debugging and algorithmic explanations.\',\\n    },\\n    screening2: {\\n      status: \'PENDING\',\\n      notes: \'Behavioral & rubric accuracy evaluation.\',\\n    },\\n    adminNotes: \'Application submitted. Ready for screening interviews 1 & 2.\',\\n  };\\n  store.interviewerApplications.set(application.id, application);\\n\\n  // Initialize earnings record\\n  if (!store.earnings.has(userId)) {\\n    store.earnings.set(userId, {\\n      interviewerId: userId,\\n      pendingBalance: 0,\\n      availableBalance: 0,\\n      paidBalance: 0,\\n      totalEarned: 0,\\n      payoutHistory: [],\\n    });\\n  }\\n\\n  store.addNotification(\\n    userId,\\n    \'Interviewer Application Submitted\',\\n    \'Your application has been received. Complete the 2 screening interviews with our panel to get approved.\',\\n    \'SUCCESS\'\\n  );\\n\\n  return res.status(201).json({ success: true, profile, application });\\n});\\n\\n// Toggle availability (Online/Offline)\\ninterviewerRouter.post(\'/toggle-availability\', (req, res) => {\\n  const userId = (req.headers[\'x-user-id\'] as string) || \'usr_interviewer_1\';\\n  const profile = store.interviewerProfiles.get(userId);\\n  if (!profile) return res.status(404).json({ error: \'Interviewer profile not found\' });\\n\\n  if (profile.status !== \'APPROVED\') {\\n    return res.status(403).json({ error: \'Only approved interviewers can go online and accept sessions.\' });\\n  }\\n\\n  profile.isAvailable = !profile.isAvailable;\\n  return res.json({ success: true, isAvailable: profile.isAvailable });\\n});\\n\\n// Get interviewer earnings\\ninterviewerRouter.get(\'/earnings\', (req, res) => {\\n  const userId = (req.headers[\'x-user-id\'] as string) || \'usr_interviewer_1\';\\n  let earnings = store.earnings.get(userId);\\n\\n  if (!earnings) {\\n    earnings = {\\n      interviewerId: userId,\\n      pendingBalance: 0,\\n      availableBalance: 0,\\n      paidBalance: 0,\\n      totalEarned: 0,\\n      payoutHistory: [],\\n    };\\n    store.earnings.set(userId, earnings);\\n  }\\n\\n  // Also include completed sessions list\\n  const completedSessions = Array.from(store.bookings.values()).filter(\\n    (b) => b.interviewerId === userId && b.status === \'COMPLETED\'\\n  );\\n\\n  return res.json({ earnings, completedSessions });\\n});\\n\\n// Request payout\\ninterviewerRouter.post(\'/request-payout\', (req, res) => {\\n  const userId = (req.headers[\'x-user-id\'] as string) || \'usr_interviewer_1\';\\n  const { amount, destination } = req.body;\\n\\n  const earnings = store.earnings.get(userId);\\n  if (!earnings) return res.status(404).json({ error: \'Earnings record not found\' });\\n\\n  const numAmount = Number(amount);\\n  if (isNaN(numAmount) || numAmount <= 0) {\\n    return res.status(400).json({ error: \'Invalid payout amount\' });\\n  }\\n\\n  if (numAmount > earnings.availableBalance) {\\n    return res.status(400).json({ error: `Amount exceeds available balance (\342\202\271${earnings.availableBalance})` });\\n  }\\n\\n  const payoutRef = \'PAY-\' + new Date().getFullYear() + \'-\' + Math.floor(1000 + Math.random() * 9000);\\n  const payout: PayoutRecord = {\\n    id: \'pay_\' + Math.random().toString(36).substring(2, 9),\\n    payoutRef,\\n    amount: numAmount,\\n    status: \'PROCESSED\',\\n    destination: destination || \'Verified UPI ID\',\\n    referenceCode: \'NEFT-\' + Math.floor(100000000 + Math.random() * 900000000),\\n    createdAt: new Date().toISOString(),\\n    processedAt: new Date().toISOString(),\\n  };\\n\\n  earnings.availableBalance -= numAmount;\\n  earnings.paidBalance += numAmount;\\n  earnings.payoutHistory.unshift(payout);\\n\\n  // Record in ledger\\n  store.addLedgerEntry({\\n    userId,\\n    type: \'PAYOUT_DEBIT\',\\n    amount: -numAmount,\\n    description: `Payout processed (${payoutRef}) to ${destination || \'UPI/Bank\'}`,\\n    referenceId: payoutRef,\\n  });\\n\\n  store.addNotification(\\n    userId,\\n    \'Payout Transferred!\',\\n    `Payout of \342\202\271${numAmount} (${payoutRef}) has been successfully processed to ${destination || \'your registered account\'}.`,\\n    \'SUCCESS\'\\n  );\\n\\n  return res.json({ success: true, payout, earnings });\\n});\\n\\n// Get Availability slots\\ninterviewerRouter.get(\'/availability\', (req, res) => {\\n  const userId = (req.headers[\'x-user-id\'] as string) || \'usr_interviewer_1\';\\n  const slots = Array.from(store.availability.values()).filter((a) => a.interviewerId === userId);\\n  return res.json({ slots });\\n});\\n\\n// Update Availability slots\\ninterviewerRouter.post(\'/availability\', (req, res) => {\\n  const userId = (req.headers[\'x-user-id\'] as string) || \'usr_interviewer_1\';\\n  const { slots } = req.body; // array of { dayOfWeek, startTime, endTime }\\n\\n  // Clear existing\\n  for (const [id, s] of store.availability.entries()) {\\n    if (s.interviewerId === userId) {\\n      store.availability.delete(id);\\n    }\\n  }\\n\\n  if (Array.isArray(slots)) {\\n    for (const s of slots) {\\n      const slot = {\\n        id: \'avail_\' + Math.random().toString(36).substring(2, 9),\\n        interviewerId: userId,\\n        dayOfWeek: s.dayOfWeek,\\n        startTime: s.startTime,\\n        endTime: s.endTime,\\n        isActive: true,\\n      };\\n      store.availability.set(slot.id, slot);\\n    }\\n  }\\n\\n  return res.json({ success: true, slots: Array.from(store.availability.values()).filter((a) => a.interviewerId === userId) });\\n});\\n\", \"Description\":\"Create interviewer routes for application, screening, availability, earnings, and payouts\", \"Overwrite\":true, \"TargetFile\":\"/src/server/routes/interviewer.ts\", \"toolAction\":\"Writing file\", \"toolSummary\":\"Create interviewer routes\"}"
      thinking_signature: "\022\257\006\n\254\006\001i\024}\023>\326w=\323\370p\345\202\304\376#\024\333\026\230\306\216\2050\276\004\341\332\227\317r\036\024-\303rl\037\273C\255j\035U\370\351|Z1X\235M\227\2078\327 \301W\334x\234\300*\337\003$\034h\320\'_F(\205\240\"c\365K\311\037\306f\265\250=\276M\345\332\365\236\375\025Ck\211\234\300\311\2730\322\033\t\344\202\237\347\277xN\371\335r=\307,\225f\037`G\253\a\356\255\2438\032\305\220\343oq\bpN\302I\260$oRa\260(\244\024\362\310\311\330\236\223\242\210\345M\346\340\374\032Eh\342\037\356\241L\201\226Y\377\331\377U\306\265MZ\022\034\005l\020u7J\023\0233\253N\276z*\354\367\343\240mD\240\325z\201\266\215\311\314s\222\002\236\374\3012|p\t{\334\242\023k\'\271\r\a\323C\204\263>\247\335\270\a\240\275v\020\223\201\343\327d\262\022\355:\271:aBb\003\005\002\222\vD3m_\033Y\031\v\020\263\367\302\f\224\376\211\303\221-h\245\177\355\v\321\227\367+y\r*3!\263Y\301,ij\353\3066\264d\332\177\265\331\267r\360{Sx\334\303\240\275\2623\302@6\020\224\363\322\2713$\213\230\260[WX\262\352\342S\032\321\027\326\277\001\306\307\214N\247c\331X\025`z\202\251KayA\202\252\376O\356_\225\257,]\2509\006!mb\343\n\346\36617\215>\300\211\205\276\303\252G\267B\234=$9\233\024\363r\352S\202I@\340\276Q\327\'`\327\344\333@/\326\r\324D\n\320o\320\260\365\221)4qr\350\366$\335\301\317\205\rCh\232d\335\264\210\226\306X\347}\301\214\376\303\021.\205\036\274\313\320\243\245\006\352\276\235_Yx?\267\364lV\203\202\361\243\035\t\243$d`-O\000|_]5\3469\304|I\275\017\\\314\003\237\364>\355\237\213_\016\266\000\033(\2347*\017@\370\025\"`\021\264\321\352\251|\234|\276\205Y\203\322\021ap\361\253\005\324\312a=\022%\001P\030\357\213\3177\t\375\023\366\340\214W\36347\232(\330\321\230x\302\023\3103\225\\\275\036i\266\305Or\027\253\220?\323]\nJ\225fK\036\247TBF\245\316C\335D\031|\2469\351\017o\216gh\n\223j\002\311\304-\226Lg\274\242X\302\272zx\251\001f\311E%|\375\035\365f\323\242\t\332w\301\260\314q\251\316O\342JR\234\215a\016\316\224&\271\231\246\370g\322\265\201\032\357[\2667\3104\