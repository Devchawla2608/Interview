      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Destructure theme in CandidateDashboard and adapt welcome banner\", \"EndLine\":91, \"Instruction\":\"Add const { theme } = useTheme() and update banner classes\", \"ReplacementContent\":\"  const { theme } = useTheme();\\n  const [bookings, setBookings] = useState<Booking[]>([]);\\n  const [myQueue, setMyQueue] = useState<{\\n    inQueue: boolean;\\n    entry?: QueueEntry;\\n    booking?: Booking;\\n    position?: number;\\n    estimatedWaitMins?: number;\\n  }>({ inQueue: false });\\n  const [loading, setLoading] = useState(true);\\n\\n  useEffect(() => {\\n    loadData();\\n    const interval = setInterval(loadData, 6000);\\n    return () => clearInterval(interval);\\n  }, [currentUser?.id]);\\n\\n  const loadData = async () => {\\n    try {\\n      const [bookingsRes, queueRes] = await Promise.all([\\n        api.getBookings(),\\n        api.getMyQueueStatus(),\\n      ]);\\n      setBookings(bookingsRes.bookings || []);\\n      setMyQueue(queueRes);\\n    } catch (err) {\\n      console.error(\'Failed to load candidate dashboard data:\', err);\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  const activeBookings = bookings.filter((b) =>\\n    [\'QUEUED\', \'CLAIMED\', \'SCHEDULED\', \'READY\', \'IN_PROGRESS\'].includes(b.status)\\n  );\\n  const completedBookings = bookings.filter((b) => b.status === \'COMPLETED\');\\n  const candProf = currentUser?.candidateProfile;\\n\\n  return (\\n    <div className=\\\"space-y-8 pb-16\\\">\\n      {/* Welcome Banner */}\\n      <div className={`relative overflow-hidden rounded-3xl border p-6 sm:p-8 transition-colors ${\\n        theme === \'light\'\\n          ? \'bg-gradient-to-r from-indigo-50 via-white to-amber-50/60 border-indigo-100/80 shadow-md text-slate-900\'\\n          : \'bg-gradient-to-r from-indigo-950 via-slate-900 to-indigo-900 border-indigo-900/40 shadow-2xl text-white\'\\n      }`}>\\n        <div className=\\\"relative z-10 max-w-3xl\\\">\\n          <div className=\\\"inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-400 dark:text-indigo-300 text-xs font-semibold mb-4\\\">\\n            <Sparkles className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Targeting Top Engineering Roles</span>\\n          </div>\\n          <h1 className={`text-2xl sm:text-4xl font-extrabold tracking-tight leading-tight ${theme === \'light\' ? \'text-slate-900\' : \'text-white\'}`}>\\n            Welcome back, {currentUser?.fullName || \'Candidate\'}!\\n          </h1>\\n          <p className={`mt-2 text-sm sm:text-base leading-relaxed ${theme === \'light\' ? \'text-slate-600\' : \'text-slate-300\'}`}>\\n            Practice live technical rounds with experienced industry interviewers. Select your target company tier, join the real-time queue or schedule, and receive structured rubric feedback.\\n          </p>\", \"StartLine\":38, \"TargetContent\":\"  const [bookings, setBookings] = useState<Booking[]>([]);\\n  const [myQueue, setMyQueue] = useState<{\\n    inQueue: boolean;\\n    entry?: QueueEntry;\\n    booking?: Booking;\\n    position?: number;\\n    estimatedWaitMins?: number;\\n  }>({ inQueue: false });\\n  const [loading, setLoading] = useState(true);\\n\\n  useEffect(() => {\\n    loadData();\\n    const interval = setInterval(loadData, 6000);\\n    return () => clearInterval(interval);\\n  }, [currentUser?.id]);\\n\\n  const loadData = async () => {\\n    try {\\n      const [bookingsRes, queueRes] = await Promise.all([\\n        api.getBookings(),\\n        api.getMyQueueStatus(),\\n      ]);\\n      setBookings(bookingsRes.bookings || []);\\n      setMyQueue(queueRes);\\n    } catch (err) {\\n      console.error(\'Failed to load candidate dashboard data:\', err);\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  const activeBookings = bookings.filter((b) =>\\n    [\'QUEUED\', \'CLAIMED\', \'SCHEDULED\', \'READY\', \'IN_PROGRESS\'].includes(b.status)\\n  );\\n  const completedBookings = bookings.filter((b) => b.status === \'COMPLETED\');\\n  const candProf = currentUser?.candidateProfile;\\n\\n  return (\\n    <div className=\\\"space-y-8 pb-16\\\">\\n      {/* Welcome Banner */}\\n      <div className=\\\"relative overflow-hidden rounded-3xl bg-gradient-to-r from-indigo-950 via-slate-900 to-indigo-900 border border-indigo-900/40 p-6 sm:p-8 shadow-2xl\\\">\\n        <div className=\\\"relative z-10 max-w-3xl\\\">\\n          <div className=\\\"inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-xs font-semibold mb-4\\\">\\n            <Sparkles className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Targeting Top Engineering Roles</span>\\n          </div>\\n          <h1 className=\\\"text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight\\\">\\n            Welcome back, {currentUser?.fullName || \'Candidate\'}!\\n          </h1>\\n          <p className=\\\"mt-2 text-sm sm:text-base text-slate-300 leading-relaxed\\\">\\n            Practice live technical rounds with experienced industry interviewers. Select your target company tier, join the real-time queue or schedule, and receive structured rubric feedback.\\n          </p>\", \"TargetFile\":\"/src/components/CandidateDashboard.tsx\", \"toolAction\":\"Updating CandidateDashboard hero banner\", \"toolSummary\":\"Add theme support to CandidateDashboard hero banner\"}"
