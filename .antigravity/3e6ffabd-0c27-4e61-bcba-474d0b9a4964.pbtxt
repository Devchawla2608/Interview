ail: candidate.email,\n      interviewerId: interviewer.id,\n      interviewerName: interviewer.fullName,\n      tierCode: \'TIER_A\',\n      trackName: \'Google Track\',\n      roundName: \'Round 1: Online Assessment / Algorithmic Screen\',\n      roundNumber: 1,\n      roundDurationMins: 45,\n      bookingType: \'QUEUE\',\n      status: \'COMPLETED\',\n      preferredLanguage: \'Python\',\n      jobRole: \'Software Engineer\',\n      price: 100,\n      platformFee: 20,\n      totalAmount: 100,\n      interviewerEarnings: 80,\n      paymentOrderId: \'order_8812\',\n      paymentStatus: \'PAID\',\n      meetingUrl: \'https://meet.jit.si/InterviewArena-IA-2026-8812\',\n      meetingProvider: \'DEV_FALLBACK_SANDBOX\',\n      createdAt: new Date(Date.now() - 12 * 86400000).toISOString(),\n      updatedAt: new Date(Date.now() - 12 * 86400000 + 3600000).toISOString(),\n    };\n    this.bookings.set(b1.id, b1);\n\n    // Feedback for Booking 1\n    const fb1: InterviewFeedback = {\n      id: \'fb_8812\',\n      bookingId: b1.id,\n      interviewerId: interviewer.id,\n      interviewerName: interviewer.fullName,\n      candidateId: candidate.id,\n      criteriaScores: [\n        { criterion: \'Problem Understanding\', score: 5, comments: \'Quickly digested problem constraints and clarified two-pointer boundaries.\' },\n        { criterion: \'Approach & Optimal Time Complexity\', score: 4, comments: \'Identified O(N) sliding window after briefly considering O(N^2).\' },\n        { criterion: \'Code Correctness\', score: 4, comments: \'Clean Python syntax; handled zero-length input properly.\' },\n        { criterion: \'Edge Cases Handling\', score: 4, comments: \'Accounted for duplicate characters and empty arrays.\' },\n      ],\n      overallScore: 4.3,\n      strengths: \'Strong analytical mindset, fast whiteboard prototyping, vocal thinking.\',\n      improvementAreas: \'Spend an extra minute upfront writing test cases before diving into code.\',\n      recommendedTopics: [\'Sliding Window Variants\', \'Prefix Sums\', \'Two Pointers\'],\n      recommendedNextRound: \'Round 2: Technical Coding Interview (Trees & Graphs)\',\n      practiceReadiness: \'JOB_READY\',\n      submittedAt: new Date(Date.now() - 12 * 86400000 + 4000000).toISOString(),\n    };\n    this.feedback.set(b1.id, fb1);\n\n    // Review for Booking 1\n    const rev1: CandidateReview = {\n      id: \'rev_8812\',\n      bookingId: b1.id,\n      candidateId: candidate.id,\n      interviewerId: interviewer.id,\n      rating: 5,\n      comment: \'Super helpful feedback! Sarah simulated the actual Google coding round atmosphere and gave actionable advice.\',\n      createdAt: new Date(Date.now() - 12 * 86400000 + 4500000).toISOString(),\n    };\n    this.reviews.set(b1.id, rev1);\n\n    // Ledger for Booking 1\n    this.addLedgerEntry({\n      bookingId: b1.id,\n      userId: candidate.id,\n      type: \'PAYMENT_RECEIVED\',\n      amount: 100,\n      description: \'Payment received for Booking IA-2026-8812 (Google Track Round 1)\',\n      referenceId: \'PAY-ORD-8812\',\n    });\n    this.addLedgerEntry({\n      bookingId: b1.id,\n      userId: \'admin\',\n      type: \'PLATFORM_COMMISSION\',\n      amount: 20,\n      description: \'Platform 20% commission retained for Booking IA-2026-8812\',\n      referenceId: \'COMM-8812\',\n    });\n    this.addLedgerEntry({\n      bookingId: b1.id,\n      userId: interviewer.id,\n      type: \'INTERVIEWER_CREDIT\',\n      amount: 80,\n      description: \'Interviewer 80% earnings credited for Booking IA-2026-8812\',\n      referenceId: \'INT-CRED-8812\',\n    });\n\n    // Booking 2: Active Waiting Queue Entry (Ready to test atomic claim!)\n    const b2: Booking = {\n      id: \'book_live_02\',\n      bookingRef: \'IA-2026-9403\',\n      candidateId: candidate.id,\n      candidateName: candidate.fullName,\n      candidateEmail: candidate.email,\n      tierCode: \'TIER_A\',\n      trackName: \'Meta Track\',\n      roundName: \'Round 2: Technical Coding Interview\',\n      roundNumber: 2,\n      roundDurationMins: 60,\n      bookingType: \'QUEUE\',\n      status: \'QUEUED\',\n      preferredLanguage: \'Python\',\n      jobRole: \'Full-Stack Engineer\',\n      price: 100,\n      platformFee: 20,\n      totalAmount: 100,\n      interviewerEarnings: 80,\n      paymentOrderId: \'order_9403\',\n      paymentStatus: \'PAID\',\n      meetingUrl: \'https://meet.jit.si/InterviewArena-IA-2026-9403\',\n      meetingProvider: \'DEV_FALLBACK_SANDBOX\',\n      createdAt: new Date(Date.now() - 3 * 60000).toISOString(),\n      updatedAt: new Date(Date.now() - 3 * 60000).toISOString(),\n    };\n    this.bookings.set(b2.id, b2);\n\n    const q2: QueueEntry = {\n      id: \'queue_9403\',\n      bookingId: b2.id,\n      candidateId: candidate.id,\n      candidateName: candidate.fullName,\n      tierCode: \'TIER_A\',\n      trackName: \'Meta Track\',\n      roundName: \'Round 2: Technical Coding Interview\',\n      roundNumber: 2,\n      jobRole: \'Full-Stack Engineer\',\n      durationMins: 60,\n      preferredLanguage: \'Python\',\n      expectedCompensation: 80,\n      status: \'WAITING\',\n      enteredAt: new Date(Date.now() - 3 * 60000).toISOString(),\n      timeoutAt: new Date(Date.now() + 12 * 60000).toISOString(),\n    };\n    this.queueEntries.set(b2.id, q2);\n\n    this.addLedgerEntry({\n      bookingId: b2.id,\n      userId: candidate.id,\n      type: \'PAYMENT_RECEIVED\',\n      amount: 100,\n      description: \'Payment received for Booking IA-2026-9403 (Meta Track Round 2)\',\n      referenceId: \'PAY-ORD-9403\',\n    });\n\n    // Booking 3: Another waiting session in Tier B (FinTech Engineering)\n    const b3: Booking = {\n      id: \'book_live_03\',\n      bookingRef: \'IA-2026-9411\',\n      candidateId: \'usr_cand_ext_1\',\n      candidateName: \'Rohan Verma\',\n      candidateEmail: \'rohan.v@example.com\',\n      tierCode: \'TIER_B\',\n      trackName: \'FinTech Engineering Track\',\n      round