    content: "\n  const fetchNotifications = async () => {\n    try {\n      const res = await api.getNotifications();\n      setNotifications(res.notifications || []);\n    } catch {\n      // ignore\n    }\n  };\n\n  const handleRoleSwitch = async (role: \'CANDIDATE\' | \'INTERVIEWER\' | \'ADMIN\') => {\n    try {\n      const res = await api.switchRole(role);\n      setCurrentUser(res.user.id, role);\n      onUserChange(res.user);\n      if (role === \'CANDIDATE\') setActiveTab(\'candidate-dashboard\');\n      else if (role === \'INTERVIEWER\') setActiveTab(\'interviewer-dashboard\');\n      else if (role === \'ADMIN\') setActiveTab(\'admin-dashboard\');\n      setShowUserMenu(false);\n    } catch (err: any) {\n      alert(err.message);\n    }\n  };\n\n  const handleQuickUserSwitch = async (userId: string, role: string) => {\n    try {\n      setCurrentUser(userId, role);\n      const res = await api.getMe();\n      onUserChange(res.user);\n      if (role === \'CANDIDATE\') setActiveTab(\'candidate-dashboard\');\n      else if (role === \'INTERVIEWER\') setActiveTab(\'interviewer-dashboard\');"
