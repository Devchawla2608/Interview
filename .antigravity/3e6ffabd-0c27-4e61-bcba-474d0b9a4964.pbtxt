  code_action {
    action_spec {
      create_file {
        instruction: "import { Router } from \'express\';\nimport { store } from \'../store\';\n\nexport const notificationsRouter = Router();\n\nnotificationsRouter.get(\'/\', (req, res) => {\n  const userId = (req.headers[\'x-user-id\'] as string) || \'usr_candidate_1\';\n  const list = store.notifications.filter((n) => n.userId === userId);\n  return res.json({ notifications: list });\n});\n\nnotificationsRouter.post(\'/:id/read\', (req, res) => {\n  const { id } = req.params;\n  const notif = store.notifications.find((n) => n.id === id);\n  if (notif) {\n    notif.isRead = true;\n  }\n  return res.json({ success: true, notif });\n});\n\nnotificationsRouter.post(\'/read-all\', (req, res) => {\n  const userId = (req.headers[\'x-user-id\'] as string) || \'usr_candidate_1\';\n  for (const n of store.notifications) {\n    if (n.userId === userId) {\n      n.isRead = true;\n    }\n  }\n  return res.json({ success: true });\n});\n"
        path {
          absolute_uri: "file:///src/server/routes/notifications.ts"
        }
        overwrite: true
      }
    }
