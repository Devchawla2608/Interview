  planner_response {
    thinking: "**Defining Session Workspace**\n\nI\'m now focusing on constructing the `SessionWorkspace` component. My current thinking revolves around its essential elements: a session header. This header will display crucial session information, including the booking reference, candidate and interviewer details, along with the tier code, company track, round title, and duration of the interview.\n\n\n"
    tool_calls {
      id: "call_738990"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport { Booking, InterviewFeedback, CandidateReview, User } from \'../types\';\\nimport { api } from \'../services/api\';\\nimport {\\n  Video,\\n  Clock,\\n  CheckSquare,\\n  FileText,\\n  ShieldAlert,\\n  Star,\\n  ExternalLink,\\n  Play,\\n  Pause,\\n  RotateCcw,\\n  Sparkles,\\n  AlertTriangle,\\n  Lock,\\n  MessageSquare,\\n  ArrowLeft,\\n} from \'lucide-react\';\\n\\ninterface SessionWorkspaceProps {\\n  bookingId: string;\\n  currentUser: User | null;\\n  onBack: () => void;\\n  onOpenFeedbackModal: (bookingId: string) => void;\\n  onOpenReviewModal: (bookingId: string) => void;\\n}\\n\\nexport const SessionWorkspace: React.FC<SessionWorkspaceProps> = ({\\n  bookingId,\\n  currentUser,\\n  onBack,\\n  onOpenFeedbackModal,\\n  onOpenReviewModal,\\n}) => {\\n  const [booking, setBooking] = useState<Booking | null>(null);\\n  const [feedback, setFeedback] = useState<InterviewFeedback | null>(null);\\n  const [review, setReview] = useState<CandidateReview | null>(null);\\n  const [loading, setLoading] = useState(true);\\n\\n  // Timer\\n  const [secondsRemaining, setSecondsRemaining] = useState(45 * 60);\\n  const [timerRunning, setTimerRunning] = useState(false);\\n\\n  // Notes\\n  const [privateNotes, setPrivateNotes] = useState(\'\');\\n  const [sharedNotes, setSharedNotes] = useState(\\n    \'// Problem Scratchpad / Live Code Space\\\\n\\\\nfunction solve(input) {\\\\n  // Candidate & Interviewer shared workspace\\\\n  return true;\\\\n}\'\\n  );\\n\\n  // Checklist\\n  const [checklist, setChecklist] = useState([\\n    { id: 1, text: \'Confirm audio/video connectivity & candidate identity\', done: true },\\n    { id: 2, text: \'Introduce round format, expectations & 45-min duration\', done: true },\\n    { id: 3, text: \'Present algorithmic coding / system design problem\', done: false },\\n    { id: 4, text: \'Evaluate clarifying questions & time complexity analysis\', done: false },\\n    { id: 5, text: \'Inspect edge cases, modularity, and test runs\', done: false },\\n    { id: 6, text: \'Reserve 5 mins for candidate Q&A and verbal debrief\', done: false },\\n  ]);\\n\\n  // Dispute modal state\\n  const [showDisputeModal, setShowDisputeModal] = useState(false);\\n  const [disputeReason, setDisputeReason] = useState(\'Candidate No-Show\');\\n  const [disputeDescription, setDisputeDescription] = useState(\'\');\\n  const [disputeSuccess, setDisputeSuccess] = useState(false);\\n\\n  useEffect(() => {\\n    loadSession();\\n  }, [bookingId]);\\n\\n  useEffect(() => {\\n    let interval: any = null;\\n    if (timerRunning && secondsRemaining > 0) {\\n      interval = setInterval(() => {\\n        setSecondsRemaining((prev) => prev - 1);\\n      }, 1000);\\n    } else if (secondsRemaining === 0) {\\n      setTimerRunning(false);\\n    }\\n    return () => clearInterval(interval);\\n  }, [timerRunning, secondsRemaining]);\\n\\n  const loadSession = async () => {\\n    try {\\n      const res = await api.getBookingDetails(bookingId);\\n      setBooking(res.booking);\\n      setFeedback(res.feedback || null);\\n      setReview(res.review || null);\\n      if (res.booking) {\\n        setSecondsRemaining(res.booking.roundDurationMins * 60);\\n      }\\n    } catch (err) {\\n      console.error(\'Failed to load session workspace:\', err);\\n    } finally {\\n      setLoading(false);\\n    }\\n  };\\n\\n  const handleToggleChecklist = (id: number) => {\\n    setChecklist((prev) =>\\n      prev.map((c) => (c.id === id ? { ...c, done: !c.done } : c))\\n    );\\n  };\\n\\n  const formatTimer = (secs: number) => {\\n    const mins = Math.floor(secs / 60);\\n    const remainder = secs % 60;\\n    return `${mins.toString().padStart(2, \'0\')}:${remainder.toString().padStart(2, \'0\')}`;\\n  };\\n\\n  const isInterviewer = currentUser?.id === booking?.interviewerId;\\n  const isCandidate = currentUser?.id === booking?.candidateId;\\n\\n  const handleDisputeSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!booking) return;\\n\\n    try {\\n      await api.reportDispute(booking.id, disputeReason, disputeDescription);\\n      setDisputeSuccess(true);\\n      setTimeout(() => setShowDisputeModal(false), 2000);\\n    } catch (err: any) {\\n      alert(err.message || \'Failed to file report\');\\n    }\\n  };\\n\\n  if (loading || !booking) {\\n    return (\\n      <div className=\\\"py-20 text-center text-slate-400\\\">\\n        Loading interview workspace...\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div className=\\\"space-y-6 pb-16\\\">\\n      {/* Top Bar */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-800\\\">\\n        <div className=\\\"flex items-center space-x-3\\\">\\n          <button\\n            onClick={onBack}\\n            className=\\\"p-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:bg-slate-800 transition\\\"\\n          >\\n            <ArrowLeft className=\\\"w-4 h-4\\\" />\\n          </button>\\n          <div>\\n            <div className=\\\"flex items-center space-x-2\\\">\\n              <span className=\\\"text-[10px] font-bold px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300\\\">\\n                {booking.tierCode.replace(\'_\', \' \')}\\n              </span>\\n              <span className=\\\"text-xs text-slate-400\\\">Ref: {booking.bookingRef}</span>\\n              <span\\n                className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${\\n                  booking.status === \'COMPLETED\'\\n                    ? \'bg-emerald-500/20 text-emerald-300\'\\n                    : \'bg-indigo-500/20 text-indigo-300\'\\n                }`}\\n              >\\n                {booking.status.replace(\'_\', \' \')}\\n              </span>\\n            </div>\\n            <h1 className=\\\"text-xl sm:text-2xl font-extrabold text-white mt-1\\\">\\n              {booking.trackName} \342\200\224 {booking.roundName}\\n            </h1>\\n          </div>\\n        </div>\\n\\n        {/* Actions */}\\n        <div className=\\\"flex items-center space-x-3\\\">\\n          <button\\n            onClick={() => setShowDisputeModal(true)}\\n            className=\\\"px-3 py-2 rounded-xl border border-rose-500/30 text-rose-300 hover:bg-rose-500/10 text-xs font-semibold transition flex items-center space-x-1.5\\\"\\n          >\\n            <AlertTriangle className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Report Problem</span>\\n          </button>\\n\\n          {isInterviewer && booking.status !== \'COMPLETED\' && (\\n            <button\\n              onClick={() => onOpenFeedbackModal(booking.id)}\\n              className=\\\"px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md shadow-indigo-600/30 transition flex items-center space-x-2\\\"\\n            >\\n              <Sparkles className=\\\"w-4 h-4\\\" />\\n              <span>Submit Structured Feedback</span>\\n            </button>\\n          )}\\n\\n          {isCandidate && booking.status === \'COMPLETED\' && !review && (\\n            <button\\n              onClick={() => onOpenReviewModal(booking.id)}\\n              className=\\\"px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold shadow-md transition flex items-center space-x-2\\\"\\n            >\\n              <Star className=\\\"w-4 h-4\\\" />\\n              <span>Rate Interviewer</span>\\n            </button>\\n          )}\\n        </div>\\n      </div>\\n\\n      {/* Main Grid: Video/Meeting Link + Timer + Scratchpads */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n        {/* Left Column: Meeting room & details */}\\n        <div className=\\\"lg:col-span-7 space-y-6\\\">\\n          {/* Meeting Room Card */}\\n          <div className=\\\"rounded-3xl bg-slate-900 border border-slate-800 p-6 space-y-5 shadow-xl\\\">\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <div className=\\\"flex items-center space-x-3\\\">\\n                <div className=\\\"w-10 h-10 rounded-xl bg-indigo-600/20 text-indigo-400 flex items-center justify-center\\\">\\n                  <Video className=\\\"w-5 h-5\\\" />\\n                </div>\\n                <div>\\n                  <h3 className=\\\"text-base font-bold text-white\\\">Live Meeting Conference</h3>\\n                  <p className=\\\"text-xs text-slate-400\\\">\\n                    Provider:{\' \'}\\n                    <span className=\\\"text-indigo-300 font-medium\\\">\\n                      {booking.meetingProvider === \'GOOGLE_MEET\'\\n                        ? \'Google Meet (Calendar API)\'\\n                        : \'Dev Video Sandbox (Jitsi)\'}\\n                    </span>\\n                  </p>\\n                </div>\\n              </div>\\n\\n              <span className=\\\"text-[11px] font-bold px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30\\\">\\n                MEETING READY\\n              </span>\\n            </div>\\n\\n            {/* Provider notice */}\\n            {booking.meetingProvider === \'DEV_FALLBACK_SANDBOX\' && (\\n              <div className=\\\"p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-[11px] text-slate-400 space-y-1\\\">\\n                <div className=\\\"text-indigo-400 font-semibold flex items-center space-x-1.5\\\">\\n                  <ShieldAlert className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Development Fallback Enabled</span>\\n                </div>\\n                <p>\\n                  Google Calendar OAuth credentials are not configured in `.env`. The platform automatically provisions a real-time web video room so you can immediately conduct the practice interview without interruptions.\\n                </p>\\n              </div>\\n            )}\\n\\n            <div className=\\\"p-5 rounded-2xl bg-slate-950 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n              <div>\\n                <div className=\\\"text-xs text-slate-400\\\">Encrypted Meeting URL:</div>\\n                <div className=\\\"text-sm font-mono text-indigo-300 truncate max-w-sm mt-0.5\\\">\\n                  {booking.meetingUrl}\\n                </div>\\n              </div>\\n\\n              <a\\n                href={booking.meetingUrl}\\n                target=\\\"_blank\\\"\\n                rel=\\\"noopener noreferrer\\\"\\n                className=\\\"px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs shadow-md shadow-indigo-600/30 transition flex items-center justify-center space-x-2 shrink-0\\\"\\n              >\\n                <span>Join Meeting Call</span>\\n                <ExternalLink className=\\\"w-4 h-4\\\" />\\n              </a>\\n            </div>\\n\\n            {/* Participants Info */}\\n            <div className=\\\"grid grid-cols-2 gap-3 pt-2\\\">\\n              <div className=\\\"p-3.5 rounded-2xl bg-slate-950 border border-slate-800 text-xs\\\">\\n                <div className=\\\"text-[11px] text-slate-400\\\">Candidate</div>\\n                <div className=\\\"font-bold text-white mt-0.5\\\">{booking.candidateName}</div>\\n                <div className=\\\"text-[11px] text-indigo-400 mt-0.5\\\">{booking.jobRole}</div>\\n              </div>\\n\\n              <div className=\\\"p-3.5 rounded-2xl bg-slate-950 border border-slate-800 text-xs\\\">\\n                <div className=\\\"text-[11px] text-slate-400\\\">Assigned Interviewer</div>\\n                <div className=\\\"font-bold text-white mt-0.5\\\">{booking.interviewerName || \'Unassigned\'}</div>\\n                <div className=\\\"text-[11px] text-emerald-400 mt-0.5\\\">Verified Industry Bar</div>\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Shared Problem Scratchpad */}\\n          <div className=\\\"rounded-3xl bg-slate-900 border border-slate-800 p-6 space-y-3 shadow-xl\\\">\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <h3 className=\\\"text-sm font-bold text-white flex items-center space-x-2\\\">\\n                <FileText className=\\\"w-4 h-4 text-indigo-400\\\" />\\n                <span>Shared Code & Problem Scratchpad</span>\\n              </h3>\\n              <span className=\\\"text-[10px] text-slate-400\\\">Language: {booking.preferredLanguage}</span>\\n            </div>\\n            <textarea\\n              rows={12}\\n              value={sharedNotes}\\n              onChange={(e) => setSharedNotes(e.target.value)}\\n              className=\\\"w-full bg-slate-950 border border-slate-800 rounded-2xl p-4 font-mono text-xs text-indigo-200 focus:outline-none focus:border-indigo-500 leading-relaxed\\\"\\n            />\\n          </div>\\n        </div>\\n\\n        {/* Right Column: Timer, Checklist, Private Notes, Feedback */}\\n        <div className=\\\"lg:col-span-5 space-y-6\\\">\\n          {/* Live Countdown Timer */}\\n          <div className=\\\"rounded-3xl bg-slate-900 border border-slate-800 p-6 space-y-4 shadow-xl\\\">\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <span className=\\\"text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center space-x-1.5\\\">\\n                <Clock className=\\\"w-4 h-4 text-amber-400\\\" />\\n                <span>Interview Clock</span>\\n              </span>\\n              <span className=\\\"text-[11px] text-slate-400\\\">{booking.roundDurationMins}m Target</span>\\n            </div>\\n\\n            <div className=\\\"text-center py-2\\\">\\n              <div\\n                className={`text-5xl font-mono font-extrabold tracking-tight ${\\n                  secondsRemaining < 300 ? \'text-rose-400 animate-pulse\' : \'text-white\'\\n                }`}\\n              >\\n                {formatTimer(secondsRemaining)}\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex items-center justify-center space-x-3\\\">\\n              <button\\n                onClick={() => setTimerRunning(!timerRunning)}\\n                className={`px-4 py-2 rounded-xl text-xs font-bold transition flex items-center space-x-1.5 ${\\n                  timerRunning\\n                    ? \'bg-amber-600 hover:bg-amber-500 text-white\'\\n                    : \'bg-indigo-600 hover:bg-indigo-500 text-white\'\\n                }`}\\n              >\\n                {timerRunning ? (\\n                  <>\\n                    <Pause className=\\\"w-3.5 h-3.5\\\" />\\n                    <span>Pause</span>\\n                  </>\\n                ) : (\\n                  <>\\n                    <Play className=\\\"w-3.5 h-3.5\\\" />\\n                    <span>Start Timer</span>\\n                  </>\\n                )}\\n              </button>\\n\\n              <button\\n                onClick={() => {\\n                  setTimerRunning(false);\\n                  setSecondsRemaining(booking.roundDurationMins * 60);\\n                }}\\n                className=\\\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition\\\"\\n                title=\\\"Reset timer\\\"\\n              >\\n                <RotateCcw className=\\\"w-4 h-4\\\" />\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Interview Checklist */}\\n          <div className=\\\"rounded-3xl bg-slate-900 border border-slate-800 p-6 space-y-3 shadow-xl\\\">\\n            <h3 className=\\\"text-sm font-bold text-white flex items-center space-x-2\\\">\\n              <CheckSquare className=\\\"w-4 h-4 text-indigo-400\\\" />\\n              <span>Interview Execution Checklist</span>\\n            </h3>\\n\\n            <div className=\\\"space-y-2\\\">\\n              {checklist.map((item) => (\\n                <div\\n                  key={item.id}\\n                  onClick={() => handleToggleChecklist(item.id)}\\n                  className={`p-2.5 rounded-xl border text-xs cursor-pointer flex items-center space-x-2.5 transition ${\\n                    item.done\\n                      ? \'bg-slate-950 border-slate-800 text-slate-400 line-through\'\\n                      : \'bg-slate-800/60 border-slate-700 text-slate-200\'\\n                  }`}\\n                >\\n                  <input\\n                    type=\\\"checkbox\\\"\\n                    checked={item.done}\\n                    onChange={() => {}}\\n                    className=\\\"rounded bg-slate-900 border-slate-700 text-indigo-600 focus:ring-0\\\"\\n                  />\\n                  <span>{item.text}</span>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n\\n          {/* Private Interviewer Scratchpad */}\\n          {isInterviewer && (\\n            <div className=\\\"rounded-3xl bg-slate-900 border border-slate-800 p-6 space-y-3 shadow-xl\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <h3 className=\\\"text-sm font-bold text-amber-300 flex items-center space-x-2\\\">\\n                  <Lock className=\\\"w-4 h-4\\\" />\\n                  <span>Private Interviewer Notes</span>\\n                </h3>\\n                <span className=\\\"text-[10px] text-slate-500\\\">Not visible to candidate</span>\\n              </div>\\n              <textarea\\n                rows={5}\\n                placeholder=\\\"Jot down rough observations: e.g. \'missed empty array edge case initially, recovered nicely when hinted about two pointers\'...\\\"\\n                value={privateNotes}\\n                onChange={(e) => setPrivateNotes(e.target.value)}\\n                className=\\\"w-full bg-slate-950 border border-slate-800 rounded-2xl p-3 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-amber-500\\\"\\n              />\\n            </div>\\n          )}\\n\\n          {/* Existing Feedback Summary if submitted */}\\n          {feedback && (\\n            <div className=\\\"rounded-3xl bg-slate-900 border border-emerald-500/30 p-6 space-y-4 shadow-xl\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <h3 className=\\\"text-sm font-bold text-white flex items-center space-x-2\\\">\\n                  <Sparkles className=\\\"w-4 h-4 text-emerald-400\\\" />\\n                  <span>Performance Rubric Summary</span>\\n                </h3>\\n                <span className=\\\"text-lg font-extrabold text-emerald-400\\\">\\n                  {feedback.overallScore}/5.0\\n                </span>\\n              </div>\\n\\n              <div className=\\\"text-xs text-slate-300 space-y-2\\\">\\n                <div>\\n                  <strong className=\\\"text-white\\\">Strengths:</strong> {feedback.strengths}\\n                </div>\\n                <div>\\n                  <strong className=\\\"text-white\\\">Areas to Improve:</strong> {feedback.improvementAreas}\\n                </div>\\n                <div>\\n                  <strong className=\\\"text-white\\\">Next Round Recommendation:</strong>{\' \'}\\n                  <span className=\\\"text-indigo-300\\\">{feedback.recommendedNextRound}</span>\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n        </div>\\n      </div>\\n\\n      {/* Problem / Dispute Modal */}\\n      {showDisputeModal && (\\n        <div className=\\\"fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4\\\">\\n          <div className=\\\"bg-slate-900 border border-slate-700 rounded-3xl w-full max-w-md p-6 space-y-5 shadow-2xl\\\">\\n            <h3 className=\\\"text-base font-bold text-white\\\">Report Problem or Technical Issue</h3>\\n\\n            {disputeSuccess ? (\\n              <div className=\\\"p-4 rounded-xl bg-emerald-500/10 text-emerald-300 text-xs text-center\\\">\\n                Dispute report logged. An administrator will review session logs and issue a refund or adjustment if applicable.\\n              </div>\\n            ) : (\\n              <form onSubmit={handleDisputeSubmit} className=\\\"space-y-4\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-medium text-slate-300 mb-1\\\">Issue Category:</label>\\n                  <select\\n                    value={disputeReason}\\n                    onChange={(e) => setDisputeReason(e.target.value)}\\n                    className=\\\"w-full bg-slate-950 border border-slate-800 text-xs text-white rounded-xl p-2.5\\\"\\n                  >\\n                    <option value=\\\"Candidate No-Show\\\">Candidate No-Show</option>\\n                    <option value=\\\"Interviewer No-Show\\\">Interviewer No-Show</option>\\n                    <option value=\\\"Audio / Video Glitch\\\">Audio / Video Technical Glitch</option>\\n                    <option value=\\\"Inappropriate Conduct\\\">Inappropriate Conduct</option>\\n                    <option value=\\\"Other\\\">Other</option>\\n                  </select>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-medium text-slate-300 mb-1\\\">Description:</label>\\n                  <textarea\\n                    rows={4}\\n                    value={disputeDescription}\\n                    onChange={(e) => setDisputeDescription(e.target.value)}\\n                    placeholder=\\\"Provide details of what occurred...\\\"\\n                    required\\n                    className=\\\"w-full bg-slate-950 border border-slate-800 text-xs text-white rounded-xl p-2.5\\\"\\n                  />\\n                </div>\\n\\n                <div className=\\\"flex space-x-3\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setShowDisputeModal(false)}\\n                    className=\\\"flex-1 py-2.5 rounded-xl bg-slate-800 text-slate-300 text-xs font-semibold\\\"\\n                  >\\n                    Cancel\\n                  </button>\\n                  <button\\n                    type=\\\"submit\\\"\\n                    className=\\\"flex-1 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold\\\"\\n                  >\\n                    Submit Report\\n                  </button>\\n                </div>\\n              </form>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create dedicated SessionWorkspace with video integration, countdown timer, checklist, and scratchpads\", \"Overwrite\":true, \"TargetFile\":\"/src/components/SessionWorkspace.tsx\", \"toolAction\":\"Writing file\", \"toolSummary\":\"Create SessionWorkspace component\"}"
      thinking_signature: "\022\241\n\n\236\n\001i\024}\023\316d^\334l0\025\313\203\266Pta\203H\355\256\026\307k\366\264.\b)\355R\322+Q\225p\347J\341\252\343_\3245\300\347R\000\267E\321\204\305\203\001?\177\331\n\331\261\0236G\362U~,r\357X\233\333\230\360\265\207*\304\245\357\ajr\207\037&\365!q\031\372F(e\376eFU2\254\t!\307f\362\n7\320\023\264\257\226#\264\2130\226\315Ku\003\\Q\257\352U%\263\261\271\'d\3415;\347\3275\213\002\334^\300\306\364\006\243\211~\203\031\000\211\362\274\207\000v}\333\256\277\210\362\351c0\361p\235\0021\311\3323\327\363\353\331\001\264d)\0037\262\371\206\364G\0371\273\277\365!\266\367\205\274\325\365\033\353\030K\000@\325R&\016\367\345f\3717L\246j\025f\037\027&\237\215\'u\337\020\370\341s\226\302\307\277\353\371\235\250RrWpm\031\aaVxQ\332\016|\314\aS\325BmeC\314\264\304\032d~.\215(\317\326\021}\352c\376\271\016\035Cq\360\274\263Z\377eP\214$\254y\246\\\3326\212b\321\236\370\310\0061M\030\2349\355\016\220)z\276\025\222\003(muI\023_\341l\205\230\262\277\262\244,A\t\201\350xYaJ\261\205\345r\307\361D\377u\210_\305PK\265\303VN\370\023\367IGs\224\331;?\367\257\311\215A`\270\265p\232\247v\b\341\201\333A\177*\352\177W\325\367\335o\256U(=U\235v\354D\216\330Uu\306w\206\033\037\367o\305\372\262\255\352\322\320\205pd\216\270\327\262woP\352hvO\211\000M\217\250\343\016Y\316\245[Bj\337\317\027l\345\332}n8;\001\271\"\204\334f3\\\362\207d\206\226\020\345\230>\317\031/SWv_\240\001\005\177\332\316\343dOb\345\004\315~\305~Uw\205I\nZx\217\363\263!\327\274\235\aL}\253\352\023\031\3274\2768\234w!h\272i\b\201k\220\037)\356U\215\210\350M5c\264\340E#\222%\277T$\237\211\206\370\346J\334\037)#6n\321\344N\256\247;/\344\345\352\001\0068\347\v\324(\316\254\"_\323\326\306\377P\b\316\f\3266\204\017h\360\363\245\215)\024\270j\0160d\004*\275c\372%7i=?\000?\033t\302\204H\321\272:\201\n\220\330\006\323\245e\316\220@\251\323\337e\330\233\242\240\303|\211\205\020S_\250\257\376\t\231\232/\334\254)\203\334rBr\223\211\204\203\240\366\310\356\335\357\ad\022\026\342\000a\202M\202gk\316\360\320\037\263\363\023\357&C1\326\300f\244\352\235F\204\345\3078Rw\004M\022\244=\203\351\250\n\213\222 Nk\271\200\235\034\2611b\336\232\256\030\373\330=Bk\031\3559\335\355$\304W{\017\347\006As\377LN:\232\263+\225\331y\344\314\277\004F\0375hyS\240\033\237\177\262S]\227\265\221\341#DC\"\202\207\244\033\022\271\375y\240\221\311TK\205\017\0035\a6\205+\367\355\372c(\370\004\227\a\320,\'DPM\001\372\367\246\302\343s\347\372M\355\247\233B\215\247S\033\317\372\354\002\313(\327_/\226;\215\212\201cf\v\311z4\322\210\245\312l\275\310(\266\274\020.\035g\236\354\274\220\257\006\253\365\"\277Wn\306\231\347>\"[\254\n\2779\331\266w\300\320)1c\035$\251\n;\331\313\020\271\200#UF\304\314 \340\032\033W*\275 \257\370\232]\024oo\022e\\\277#$\274bIea\340\275\367\363\252;\361\306\033\260\233\320\027\352L\034\317\234\260n\336\222\025\324\002\367\221\232(\335^\363\367\377\b\r\345b\357f\206\220\020\020\305Wm^\327\355\020\350\254o\244\220\323\337Z\276\r$\031\0033\345j\260P\3560\257\204\216gAk\243\230\207\255\373\366\223\226\373\n\207\254\004A\256FU\001\340\030w=\b\274\3215%:\037\251\026\270:o]\346d\203\201\26200\b\200i_\242\340SM\371Z\257E\272\320\345\327\253Mf\304\352\246@\303\037\336\270\n%f\320\337\256\230\274\324\320\372\275Wl\205VR(\023)\373\217\240mE\323J)\373\223\333\377g\3343\317Q\211Y\201]P\f\033\303\234W\246\224\214\340\365R/\201\323\220\177\3427\324 2\310*\222\273\303\234+!\"\037\334\357Z\353\037\232\367\211\016-\351p\364bB\240\322\326\001\360\267\v\375BI\364\347\000\345Z\271\202\3729\0232\357\275L\357\030\3760\322\230\372\211\033\034(\332nZ|g+\0304\362R\037\354\313\211T\025\323\027\203!\315\346m\022\311^\251\311\216\335\345\313*J\242\200X\206C\024\353\375\004\022!\227=P|\330\225\225-w\362\265\t\3426\365\a\256\220r\337\0012$\273\270\367\016\253B{c<\231\r\274\314"
