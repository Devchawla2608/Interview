  code_action {
    action_spec {
      create_file {
        instruction: "# ====================================================================\n# Interview Arena \342\200\224 Environment Configuration Variables\n# ====================================================================\n\n# Application URL & Environment\nPORT=3000\nNODE_ENV=\"development\"\nAPP_URL=\"http://localhost:3000\"\n\n# Database Configuration (PostgreSQL)\n# When running with Docker Compose or external managed PostgreSQL:\nDATABASE_URL=\"postgresql://arena_user:arena_password@localhost:5432/interview_arena?schema=public\"\n\n# Authentication & Session Security\nJWT_SECRET=\"replace-with-a-secure-random-32-character-secret-key\"\nSESSION_EXPIRY_DAYS=\"7\"\n\n# Payment Gateway (Razorpay India)\n# Get keys from Razorpay Dashboard -> Settings -> API Keys (Use test mode for staging)\nRAZORPAY_KEY_ID=\"rzp_test_arena_demo\"\nRAZORPAY_KEY_SECRET=\"your_razorpay_secret_key\"\nRAZORPAY_WEBHOOK_SECRET=\"your_razorpay_webhook_secret\"\n\n# Google Calendar & Meet Conference Integration\n# Setup in Google Cloud Console -> APIs & Services -> Credentials\n# Required Scopes: https://www.googleapis.com/auth/calendar.events\nGOOGLE_CLIENT_ID=\"your_google_client_id.apps.googleusercontent.com\"\nGOOGLE_CLIENT_SECRET=\"your_google_client_secret\"\nGOOGLE_REDIRECT_URI=\"http://localhost:3000/api/auth/google/callback\"\n\n# Email Provider Integration (Resend or Amazon SES)\n# If unconfigured, the application uses real-time in-app notifications\nRESEND_API_KEY=\"re_123456789\"\nEMAIL_FROM=\"Interview Arena <notifications@interviewarena.com>\"\n\n# Optional AI capabilities (Google AI Studio)\nGEMINI_API_KEY=\"your_gemini_api_key\"\n"
