              text: "5. *Note: If Google Meet credentials are not set, Interview Arena cleanly falls back to an encrypted real-time video sandbox with transparent UI labeling.*"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 5. Docker & Production Deployment"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "To run with PostgreSQL using Docker Compose:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "```bash"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "docker-compose up --build"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "This automatically boots PostgreSQL 16 on port 5432, executes `migrations/0001_initial_schema.sql`, builds the production frontend, and starts the containerized service on port 3000."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
