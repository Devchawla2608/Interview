          target_content: "  const handleToggleUserStatus = async (user: User) => {\n    const reason = prompt(`Enter reason to ${user.isSuspended ? \'reactivate\' : \'suspend\'} user ${user.email}:`);\n    if (reason === null) return;\n\n    try {\n      await api.setUserStatus(user.id, !user.isSuspended, reason);\n      loadAllData();\n    } catch (err: any) {\n      alert(err.message || \'Failed to update user status\');\n    }\n  };\n\n  const handleEvaluateScreening = async (appId: string, action: \'APPROVE\' | \'REJECT\' | \'UPDATE_SCREENING\', screeningNumber?: number) => {\n    try {\n      await api.evaluateApplication(appId, {\n        action,\n        screeningNumber,\n        screeningStatus: \'COMPLETED\',\n        score: screeningScore,\n        notes: screeningNotes || \'Screening passed according to evaluation rubric.\',\n        adminNotes: action === \'APPROVE\' ? \'Approved after completing 2 practice screenings.\' : undefined,\n      });\n      setEvaluatingApp(null);\n      setScreeningNotes(\'\');\n      loadAllData();\n    } catch (err: any) {\n      alert(err.message || \'Failed to update application\');\n    }\n  };\n\n  const handleSaveTier = async () => {\n    if (!editingTier) return;\n    try {\n      await api.updateTier(editingTier.code, {\n        price: editingTier.price,\n        commissionPercent: editingTier.commissionPercent,\n        description: editingTier.description,\n      });\n      setEditingTier(null);\n      loadAllData();\n      alert(\'Tier updated successfully!\');\n    } catch (err: any) {\n      alert(err.message || \'Failed to update tier\');\n    }\n  };\n\n  const handleRefundAction = async (refundId: string, action: \'APPROVE\' | \'REJECT\') => {\n    const adminNotes = prompt(`Enter note for refund ${action.toLowerCase()}:`);\n    try {\n      await api.actionRefund(refundId, action, adminNotes || undefined);\n      loadAllData();\n    } catch (err: any) {\n      alert(err.message || \'Refund action failed\');\n    }\n  };\n\n  const handleResolveDispute = async (disputeId: string, resolution: string) => {\n    const adminNotes = prompt(\'Enter resolution notes:\');\n    try {\n      await api.resolveDispute(disputeId, resolution, adminNotes || undefined);\n      loadAllData();\n    } catch (err: any) {\n      alert(err.message || \'Dispute resolution failed\');\n    }\n  };\n\n  const handleSaveSettings = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!settings) return;\n    try {\n      await api.updateSettings(settings);\n      alert(\'Settings saved successfully!\');\n      loadAllData();\n    } catch (err: any) {\n      alert(err.message || \'Failed to save settings\');\n    }\n  };"
          replacement_content: "  const handleToggleUserStatus = async (user: User) => {\n    try {\n      await api.setUserStatus(user.id, !user.isSuspended, \'Administrative action\');\n      loadAllData();\n    } catch (err: any) {\n      console.error(\'Failed to update user status:\', err.message);\n    }\n  };\n\n  const handleEvaluateScreening = async (appId: string, action: \'APPROVE\' | \'REJECT\' | \'UPDATE_SCREENING\', screeningNumber?: number) => {\n    try {\n      await api.evaluateApplication(appId, {\n        action,\n        screeningNumber,\n        screeningStatus: \'COMPLETED\',\n        score: screeningScore,\n        notes: screeningNotes || \'Screening passed according to evaluation rubric.\',\n        adminNotes: action === \'APPROVE\' ? \'Approved after completing 2 practice screenings.\' : undefined,\n      });\n      setEvaluatingApp(null);\n      setScreeningNotes(\'\');\n      loadAllData();\n    } catch (err: any) {\n      console.error(\'Failed to update application:\', err.message);\n    }\n  };\n\n  const handleSaveTier = async () => {\n    if (!editingTier) return;\n    try {\n      await api.updateTier(editingTier.code, {\n        price: editingTier.price,\n        commissionPercent: editingTier.commissionPercent,\n        description: editingTier.description,\n      });\n      setEditingTier(null);\n      loadAllData();\n    } catch (err: any) {\n      console.error(\'Failed to update tier:\', err.message);\n    }\n  };\n\n  const handleRefundAction = async (refundId: string, action: \'APPROVE\' | \'REJECT\') => {\n    try {\n      await api.actionRefund(refundId, action, \'Admin processed refund action\');\n      loadAllData();\n    } catch (err: any) {\n      console.error(\'Refund action failed:\', err.message);\n    }\n  };\n\n  const handleResolveDispute = async (disputeId: string, resolution: string) => {\n    try {\n      await api.resolveDispute(disputeId, resolution, \'Reviewed and resolved by administrator\');\n      loadAllData();\n    } catch (err: any) {\n      console.error(\'Dispute resolution failed:\', err.message);\n    }\n  };\n\n  const handleSaveSettings = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!settings) return;\n    try {\n      await api.updateSettings(settings);\n      loadAllData();\n    } catch (err: any) {\n      console.error(\'Failed to save settings:\', err.message);\n    }\n  };"
