    content: "  };\n\n  const checkQueueStatus = async () => {\n    try {\n      const [queueRes, myQueueRes] = await Promise.all([\n        api.getQueue(),\n        api.getMyQueueStatus(),\n      ]);\n      setActiveQueueCount(queueRes.totalWaiting || 0);\n      setHasActiveQueue(myQueueRes.inQueue || false);\n    } catch {\n      // ignore\n    }\n  };\n\n  useEffect(() => {\n    const interval = setInterval(checkQueueStatus, 5000);\n    return () => clearInterval(interval);\n  }, []);\n\n  // Handlers\n  const handleNavigateToCatalog = (tier?: string) => {\n    setCatalogInitialTier(tier);\n    setActiveTab(\'catalog\');\n  };\n\n  const handleSelectRoundForBooking = (track: CompanyTrack, round: RoundTemplate, tier: Tier) => {\n    setBookingCheckoutTarget({ track, round, tier });\n  };\n\n  const handleBookingSuccess = (booking: Booking) => {\n    setBookingCheckoutTarget(null);\n    setHasActiveQueue(true);\n    setShowQueueTracker(true);\n  };\n"
