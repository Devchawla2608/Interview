      thinking_signature: "\022\225\f\n\222\f\001i\024}\023A\024c\266\234B\352P7\225M{-z\217\233Z\fn\227\023h\027\221\271\267>\004\372h9\350\0240\030d\270\256\375r\231\346\364)\261J`\326p\324\260\305\337\306\003\217D\354\256(\027\232\256Pt\350\023\035\240\251\333f\374\220\267\315<\230\035\353*\024\304\236\250\234\017\365,\353\361\204\234\314 \341\360\364Z\222\3379\256\245\304\001\023q\222\356\302e\246j>e+\274Z\267\230\275\307\034\211%C\211\301\304\352\375\317A\210\264\355\035\375\0266\303\001n\220\353\\\202Z`\2253Y\025\243@\334\240y\023\330]\0367\312\375\265\356\002\r\255E\274\210\257\201BU\272\237z:\335\016)f\301\277o5\314\322f\271\032\213\2509\255j\263\n\377\233\001\263\2309\342\240\242\035\\\240\356\344\034\370\276\352\f\242\377W&\033Y\240\a\231\366\336\327\235\2163\360\030<cB\211\257]\307\332\023\240\275!\237\177\217\022S\001\021\340\374\245\247\363&\003.\3678+7\305@za\276\327\203\216\025\223E\016\211\034\240\r)s#\2229\211\354r\314a\203\300E\2461\264\001\273,\205\214?\324\022\250\236H\031D\231\223\337\241\311\341\205\347\275\205\347\030\226\236S\265(]\265\372{n\331\'\260@ugiN)\031\306k\243J\346\272O^q\t\\\252\006Kf\215\022<\251O\227\240\bo+\235=F\267\253\373.\006\264-\363\356.\b\210\252\020a\306\a\277qi\347\023\213\341w7\b\001\025\020l\2479\252)\003S\177\211\310o\222\315,\177#\'\325*\325=\270\3739\vh\t\020\020\020):a\036\016\0167^\303\215\t\302\325&\374\022_\270\000\003\246\211@\220\"\3364P\3714\211.\214\301\305\337\213\364\313\332\307\263{f\305\267p\272\341\023T\262\025\035\371|\242,\207LZ#\301o\033_Ck\312(.]\330\"\364\350\232\333\234&\030s\374Gw\033\277\036\353\336\354\313\f-\023\327\222\\K\261\374\314l\000\231\250\263\271\372\016\227u\355]\fs\266\256\035\n\024jw\v\215C\354\265\006G\211\342e\321\356\257\260\211\251c\355\261\353\326A\321\246\337\360\000\223\260\bY\352Ih\242N\034\366\313\303\272\250^\000\364\233\336\006(\v\245i\274MM\337M\002Y\274\332,\322\210%t\377\310\332\250\016\254\231\371q:\f\271\314\233\273\036\322\340\3648[\036U+\304\375k\331ua\207\2475p\006\0240:\036)P\024\002r\336\206\vJ$@\375\315Cr\363}/k\023\031\227\354\027\017\312\263\241\n\352\274\0010\a\253\310\370NM\250\202\3138\233\341\233\207\b\344\360\002\000\004\225\213\3066\001\347\376\346\035<\265\34012\220\332\310\004O\266G\227V\273u6\216|w/\n*\311\254\314\304\017\314t\257nZ\307\204\006I\3442q0\231\251\336\262-\334;\251\311\226D\207\214\355\336\035\333B\244\3566\257#\016D\216\364B\205H\276\2211zp\177q\267\001EI\317\2345\270$B\037\354\031\273\3558d\323l5\264\205\002{G\020\361#\273\236\225K\274H\322Zpy\363\031\366\306S%\233\004Q\261\0041H\030\254\'l\375\355\326{\b\032\004RPH\300\304\3479\311\213I\377\230C\202~\344\030\255\273\'\036N\201\355b\253\025\275\340\000w\361\365I\335a\342\217\320\2502\225\303#B\333<D\272\020\r\342uB\367_\226\313^\235P\371\031\233\263\347\366\244\221\264rK\236\335\244XP,`3\235\353~T\263LBE#u]m\246=\246\227\030|4\201k\023/\vU\\\307\237\302\301d;\333\273St\\\223\303\227\260\3107\036[{\021f\v\325Q\217R\003#oLX\217\363\201\332\210s\274\300\257\276E4c\033~\320\216>\302\032\376\003;F%\220\254\025\201\337\365\016\325\240\f\271`\206*\361\265;8\221&\216\350\365\324\016e<\357h\235\202\2407\255\025^\t\001\005\256@\227\006]\274U\220\033\351\260 \"\023\0020U\320\274\304\003AG\2569\231\351\346xg\033\033P\352>=*\204QP\230\b\376\233\361oQ\376\223\362\366G\002h[\221|F\200\305\231\356\302+\353vb+f\033\201\365\2767\225g\221\261\374\200\230<\243g\257,\030e\033{\031\352\025>D*\333\364I\247I\033Ma\363\363\242\256\335\rJR0\361~\325\301\331i\343\277\266f\320\274\313\350S\021r\362\315\242\260\006\335\374\025R\'\277?\205\320z\353\227d\312\304\317\t\375\031\376\272\356m\035!*k\025\004l\2775R\367\352\367k\222\224\366\332}?lpL\222\325p\355\253x\307z\211\364c\275\235W\210\037\035~\252g\346\342\236\th|\023\331wA\314\033\362\343[\310\242\223\314l\302\325G\321\0316|\031\236\262\254\031\310\352\b\377\373[\255\236(\032g\032oH\a\270\275N\'\034\a\016\321\332~\031\355\322W)R\000\233\246J\226\275G\001\374\317\fW\273hxP\262\017\025\006\322\006|}r\327\000\243\253\367^\304\020\210\337\312\026\27452\214\253V\320\310\373\222\023%w\3412t\362\325\261\255\3442\345RG?n,n\341V?)n\251I\364=b\307\316@z\332F\325\271\346JHf\265\177\025|\273\315\026u\340\236\221PR\375\020\330\234P\272U\270\261\323JcQ\211\326\234\276\373`\206\206\331\003\315\0324\201\240\003\210\236\315\246\032\300\r(\334l\317\217\213}SDa\3166\341$\'\362+-\034\351\352D-\371>:\241\270\277|k\005\211Ve\f\016\352\v\360Aq\321O\275\323\025.\005\247H\354\341&\017\025\250\310\3067\370\r{\004%\332Q\314\304a\362\301\\Ma\t\273WWJ\000\322"
