  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n\n@custom-variant dark (&:where(.dark, .dark *));\n\n/* --------------------------------------------------\n   Global Theme Foundation\n-------------------------------------------------- */\nhtml.light {\n  color-scheme: light;\n}\n\nhtml.dark {\n  color-scheme: dark;\n}\n\nhtml.light body {\n  background-color: #f8fafc;\n  color: #0f172a;\n}\n\nhtml.dark body {\n  background-color: #020617;\n  color: #f8fafc;\n}\n\n/* --------------------------------------------------\n   Light Mode Overrides for Slate Surfaces\n-------------------------------------------------- */\nhtml.light header {\n  background-color: rgba(255, 255, 255, 0.95) !important;\n  border-color: #e2e8f0 !important;\n  color: #0f172a !important;\n}\n\n/* Base card surfaces: translate slate-900 to white */\nhtml.light .bg-slate-900,\nhtml.light .bg-slate-900\\/95,\nhtml.light .bg-slate-900\\/90,\nhtml.light .bg-slate-900\\/80,\nhtml.light .bg-slate-900\\/70,\nhtml.light .bg-slate-900\\/60,\nhtml.light .bg-slate-900\\/50,\nhtml.light .bg-slate-900\\/40 {\n  background-color: #ffffff !important;\n  border-color: #e2e8f0 !important;\n  color: #0f172a !important;\n}\n\n/* Background surfaces & inner panels: translate slate-950 to soft light-gray */\nhtml.light .bg-slate-950,\nhtml.light .bg-slate-950\\/90,\nhtml.light .bg-slate-950\\/80,\nhtml.light .bg-slate-950\\/70,\nhtml.light .bg-slate-950\\/60,\nhtml.light .bg-slate-950\\/50 {\n  background-color: #f8fafc !important;\n  border-color: #e2e8f0 !important;\n  color: #0f172a !important;\n}\n\n/* Secondary controls & subtle surfaces: translate slate-800 to slate-100 */\nhtml.light .bg-slate-800,\nhtml.light .bg-slate-800\\/90,\nhtml.light .bg-slate-800\\/80,\nhtml.light .bg-slate-800\\/70,\nhtml.light .bg-slate-800\\/60,\nhtml.light .bg-slate-800\\/50,\nhtml.light .bg-slate-800\\/40 {\n  background-color: #f1f5f9 !important;\n  border-color: #cbd5e1 !important;\n  color: #1e293b !important;\n}\n\nhtml.light .bg-slate-700,\nhtml.light .bg-slate-700\\/80 {\n  background-color: #e2e8f0 !important;\n  color: #334155 !important;\n}\n\n/* Modal Backdrops in Light Mode */\nhtml.light .fixed.inset-0.bg-slate-950\\/80,\nhtml.light .fixed.inset-0.bg-slate-950\\/90,\nhtml.light .fixed.inset-0.bg-black\\/80,\nhtml.light .fixed.inset-0.bg-black\\/60 {\n  background-color: rgba(15, 23, 42, 0.45) !important;\n  backdrop-filter: blur(6px) !important;\n}\n\n/* Borders in Light Mode */\nhtml.light .border-slate-800,\nhtml.light .border-slate-700,\nhtml.light .border-slate-800\\/50,\nhtml.light .border-slate-800\\/60 {\n  border-color: #e2e8f0 !important;\n}\n\n/* --------------------------------------------------\n   Text Hierarchy in Light Mode\n-------------------------------------------------- */\nhtml.light h1,\nhtml.light h2,\nhtml.light h3,\nhtml.light h4,\nhtml.light h5,\nhtml.light h6 {\n  color: #0f172a !important;\n}\n\n/* Replace text-white on headings and standard text elements,\n   BUT STRICTLY PRESERVE white text on colored buttons & action pills */\nhtml.light .text-white:not(button):not(button *):not([class*=\"bg-indigo\"]):not([class*=\"bg-emerald\"]):not([class*=\"bg-rose\"]):not([class*=\"bg-blue\"]):not([class*=\"bg-violet\"]):not(.badge-on-dark):not(.keep-white) {\n  color: #0f172a !important;\n}\n\n/* Ensure buttons ALWAYS maintain high contrast */\nhtml.light button.bg-indigo-600,\nhtml.light button.bg-indigo-500,\nhtml.light button.bg-emerald-600,\nhtml.light button.bg-emerald-500,\nhtml.light button.bg-rose-600,\nhtml.light button.bg-rose-500,\nhtml.light button.bg-blue-600,\nhtml.light button.bg-violet-600,\nhtml.light button.bg-amber-600,\nhtml.light [class*=\"bg-indigo-600\"] text,\nhtml.light [class*=\"bg-indigo-600\"] span,\nhtml.light [class*=\"bg-emerald-600\"] span,\nhtml.light [class*=\"bg-rose-600\"] span,\nhtml.light a.bg-indigo-600,\nhtml.light button.bg-indigo-600 *,\nhtml.light button.bg-emerald-600 *,\nhtml.light button.bg-rose-600 * {\n  color: #ffffff !important;\n}\n\n/* Standard Slate Text in Light Mode */\nhtml.light .text-slate-300,\nhtml.light .text-slate-200,\nhtml.light .text-slate-100 {\n  color: #334155 !important;\n}\n\nhtml.light .text-slate-400 {\n  color: #64748b !important;\n}\n\nhtml.light .text-slate-500 {\n  color: #64748b !important;\n}\n\n/* --------------------------------------------------\n   High-Contrast Colorful Badges & Pills in Light Mode\n-------------------------------------------------- */\nhtml.light .text-indigo-300,\nhtml.light .text-indigo-400 {\n  color: #3730a3 !important; /* Rich Indigo 800 */\n}\n\nhtml.light .text-emerald-300,\nhtml.light .text-emerald-400 {\n  color: #065f46 !important; /* Rich Emerald 800 */\n}\n\nhtml.light .text-amber-300,\nhtml.light .text-amber-400 {\n  color: #92400e !important; /* Rich Amber 800 */\n}\n\nhtml.light .text-rose-300,\nhtml.light .text-rose-400 {\n  color: #9f1239 !important; /* Rich Rose 800 */\n}\n\nhtml.light .bg-indigo-500\\/10,\nhtml.light .bg-indigo-500\\/20,\nhtml.light .bg-indigo-600\\/20,\nhtml.light .bg-indigo-600\\/30 {\n  background-color: #e0e7ff !important;\n  border-color: #c7d2fe !important;\n}\n\nhtml.light .bg-emerald-500\\/10,\nhtml.light .bg-emerald-500\\/20,\nhtml.light .bg-emerald-600\\/20 {\n  background-color: #d1fae5 !important;\n  border-color: #a7f3d0 !important;\n}\n\nhtml.light .bg-amber-500\\/10,\nhtml.light .bg-amber-500\\/20,\nhtml.light .bg-amber-600\\/20 {\n  background-color: #fef3c7 !important;\n  border-color: #fde68a !important;\n}\n\nhtml.light .bg-rose-500\\/10,\nhtml.light .bg-rose-500\\/20,\nhtml.light .bg-rose-600\\/20 {\n  background-color: #ffe4e6 !important;\n  border-color: #fecdd3 !important;\n}\n\n/* --------------------------------------------------\n   Form Inputs & Selects in Light Mode\n-------------------------------------------------- */\nhtml.light input,\nhtml.light select,\nhtml.light textarea {\n  background-color: #ffffff !important;\n  border-color: #cbd5e1 !important;\n  color: #0f172a !important;\n}\n\nhtml.light input::placeholder,\nhtml.light textarea::placeholder {\n  color: #94a3b8 !important;\n}\n\nhtml.light input:focus,\nhtml.light select:focus,\nhtml.light textarea:focus {\n  border-color: #6366f1 !important;\n  box-shadow: 0 0 0 1px #6366f1 !important;\n}\n\n/* --------------------------------------------------\n   Footer in Light Mode\n-------------------------------------------------- */\nhtml.light footer {\n  background-color: #ffffff !important;\n  border-color: #e2e8f0 !important;\n  color: #475569 !important;\n}\n\n/* --------------------------------------------------\n   Meeting Room Video Feed Stage (Keep Theater Canvas)\n-------------------------------------------------- */\n.meeting-stage-dark {\n  background-color: #0a0f1d !important;\n  color: #f8fafc !important;\n}\n.meeting-stage-dark * {\n  border-color: #1e293b !important;\n}\n.meeting-stage-dark .text-white {\n  color: #ffffff !important;\n}\n.meeting-stage-dark .text-slate-300 {\n  color: #cbd5e1 !important;\n}\n.meeting-stage-dark .text-slate-400 {\n  color: #94a3b8 !important;\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
