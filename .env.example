# Interview Arena - Environment Variables (.env)
# Copy this file to .env and replace placeholders with your own values.
# Never commit real credentials or API keys.

# 1. Server Configuration
PORT=3000
NODE_ENV=development

# 2. Database (MongoDB)
# For MongoDB Atlas, replace the placeholders with your connection details.
MONGODB_URI=mongodb://localhost:27017/interview_arena
# Or set your Atlas connection string here.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# 3. Authentication & Security (JWT)
# Generate a unique, long random value for your deployment.
JWT_SECRET=replace-with-a-long-random-secret
SESSION_EXPIRY_DAYS=7

# 4. Payments (Direct UPI QR & Collect)
UPI_MERCHANT_VPA=your-merchant@upi
UPI_MERCHANT_NAME=Your Business Name

# 5. Optional Razorpay (for card / net banking fallback)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 6. AI Assistant / Rubric Generation (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key
