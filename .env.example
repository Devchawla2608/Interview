# Authentication
JWT_SECRET=

# Payment Gateway (Razorpay test keys, optional UPI merchant)
RAZORPAY_KEY_ID=rzp_test_arena_demo
RAZORPAY_KEY_SECRET=
UPI_MERCHANT_VPA=

# Email Services (Optional)
RESEND_API_KEY=
EMAIL_API_KEY=

# AI Service (Optional Gemini API)
GEMINI_API_KEY=
